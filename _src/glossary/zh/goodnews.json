[
 {
  "id": "christ",
  "terms": [
   "基督"
  ],
  "text": "意思是“受膏者”，与希伯来话的“弥赛亚”相同，指神所差来的救主。"
 },
 {
  "id": "eternal-life",
  "terms": [
   "永远的生命"
  ],
  "text": "不因死亡而终结、与神同享的生命，从现在就在这地上开始。"
 },
 {
  "id": "perish",
  "terms": [
   "灭亡"
  ],
  "text": "指与神永远隔绝而沦亡。"
 },
 {
  "id": "sin",
  "terms": [
   "罪人",
   "罪的工价"
  ],
  "text": "圣经里的罪是离开神、自己作主而活。罪的工价就是因此所得的报应。"
 },
 {
  "id": "glory",
  "terms": [
   "神的荣耀"
  ],
  "text": "神光辉而圣洁的样子。人起初被造，就是要反映这荣耀。"
 },
 {
  "id": "ascetic",
  "terms": [
   "修行"
  ],
  "text": "修炼身心，努力达到觉悟或得救。"
 },
 {
  "id": "cross",
  "terms": [
   "十字架"
  ],
  "text": "罗马把罪人钉死的刑具。耶稣在这里代替我们的罪而死。"
 },
 {
  "id": "savior",
  "terms": [
   "救主"
  ],
  "text": "把人从罪和死亡中救出来的那一位，就是耶稣。"
 },
 {
  "id": "child-of-god",
  "terms": [
   "神的儿女"
  ],
  "text": "因信耶稣而可以称神为父的人。这身份不是靠行为，而是白白得来的礼物。"
 },
 {
  "id": "amen",
  "terms": [
   "阿们"
  ],
  "text": "希伯来话，意思是“诚然如此”。放在祷告末尾，表示从心里同意。"
 },
 {
  "id": "resurrection",
  "terms": [
   "复活"
  ],
  "text": "耶稣死后第三天身体活过来的事。"
 }
]