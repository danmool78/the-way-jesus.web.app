[
 {
  "id": "cherub",
  "terms": [
   "基路伯"
  ],
  "text": "基路伯是守在神身边、有翅膀的天上活物。"
 },
 {
  "id": "tree-of-life",
  "terms": [
   "生命树"
  ],
  "text": "伊甸园当中的一棵树，象征永不止息的生命。人犯罪以后，通往这棵树的路就被拦住了。"
 },
 {
  "id": "holy-spirit",
  "terms": [
   "圣灵"
  ],
  "text": "神的灵。基督教相信圣灵与圣父、圣子同为一位神。"
 },
 {
  "id": "grace",
  "terms": [
   "恩典"
  ],
  "text": "神白白赐给不配得之人的爱和礼物。"
 },
 {
  "id": "census",
  "terms": [
   "登记户口"
  ],
  "text": "罗马皇帝为收税而清点百姓人数。每个人都要回到祖籍的城去登记名字。"
 },
 {
  "id": "manger",
  "terms": [
   "马槽"
  ],
  "text": "给牛马盛饲料的槽。婴孩耶稣出生后最先就躺在这里。"
 },
 {
  "id": "savior",
  "terms": [
   "救主",
   "救世主"
  ],
  "text": "意思是“施行拯救的主”，指把人从罪和死亡中救出来的那一位。"
 },
 {
  "id": "circumcision",
  "terms": [
   "割礼"
  ],
  "text": "男孩出生第八天割去包皮的仪式，是成为神子民的立约记号。"
 },
 {
  "id": "purification",
  "terms": [
   "洁净礼",
   "洁净的规矩"
  ],
  "text": "按律法使身体和器物洁净的仪式。妇人生产后，满了一定的日子也要献祭。"
 },
 {
  "id": "law",
  "terms": [
   "律法"
  ],
  "text": "神借着摩西赐给以色列的教导和诫命，记在旧约的前五卷书里。"
 },
 {
  "id": "temple",
  "terms": [
   "圣殿"
  ],
  "text": "耶路撒冷敬拜神、献祭的宏大建筑。耶稣时代的圣殿经希律大规模重修。"
 },
 {
  "id": "christ",
  "terms": [
   "基督"
  ],
  "text": "希腊文，意思是“受膏者”，与希伯来文的“弥赛亚”同义，指神应许要差来的救主。"
 },
 {
  "id": "messiah",
  "terms": [
   "弥赛亚"
  ],
  "text": "希伯来文，意思是“受膏者”，是以色列所盼望的那位应许的救主。希腊文称为基督。"
 },
 {
  "id": "tribe",
  "terms": [
   "支派"
  ],
  "text": "从雅各十二个儿子分出来的以色列十二个宗族。"
 },
 {
  "id": "prophet",
  "terms": [
   "先知"
  ],
  "text": "领受神的话并传给人的人。重点不在预言将来，而在传达神的旨意。"
 },
 {
  "id": "fasting",
  "terms": [
   "禁食"
  ],
  "text": "为了专心祷告，在一段时间内不吃东西。"
 },
 {
  "id": "magi",
  "terms": [
   "博士"
  ],
  "text": "不是有学位的人，而是东方研究星象的学者，可能来自波斯或巴比伦一带。"
 },
 {
  "id": "high-priest",
  "terms": [
   "大祭司",
   "祭司长"
  ],
  "text": "祭司的首领，带领圣殿和犹太公会，是最高的宗教领袖。"
 },
 {
  "id": "priest",
  "terms": [
   "祭司"
  ],
  "text": "在圣殿献祭、代表百姓来到神面前的人，由亚伦的后代担任。"
 },
 {
  "id": "levite",
  "terms": [
   "利未人"
  ],
  "text": "利未支派的人，协助祭司负责圣殿的事务。"
 },
 {
  "id": "scribe",
  "terms": [
   "文士",
   "律法师",
   "教法师"
  ],
  "text": "研究并教导律法的专家。"
 },
 {
  "id": "frankincense",
  "terms": [
   "乳香"
  ],
  "text": "树脂晒干而成的贵重香料，焚烧时发出香气，用于献给神的祭。"
 },
 {
  "id": "myrrh",
  "terms": [
   "没药"
  ],
  "text": "从树脂取得的昂贵香料，可作药或香水，也用来涂抹安葬的遗体。"
 },
 {
  "id": "aloes",
  "terms": [
   "沉香"
  ],
  "text": "取自香气浓郁之木的香料，安葬时与没药调和用在遗体上。"
 },
 {
  "id": "repentance",
  "terms": [
   "悔改"
  ],
  "text": "不只是为过错懊悔，而是转变人生的方向，回到神那里。"
 },
 {
  "id": "baptism",
  "terms": [
   "悔改之洗",
   "受洗"
  ],
  "text": "浸入水中或用水施行的仪式，表示洗净罪、开始新生命。"
 },
 {
  "id": "devil",
  "terms": [
   "魔鬼",
   "撒但"
  ],
  "text": "抵挡神、要使人跌倒的恶灵之首。“撒但”的意思是“敌对者”。"
 },
 {
  "id": "lamb-of-god",
  "terms": [
   "羔羊"
  ],
  "text": "以献上代替赎罪的羔羊作比喻，指要担当世人罪孽而死的耶稣。"
 },
 {
  "id": "rabbi",
  "terms": [
   "拉比",
   "拉波尼"
  ],
  "text": "希伯来话，意思是“我的老师”，是对教导律法之师的尊称。“拉波尼”更显亲切。"
 },
 {
  "id": "sign",
  "terms": [
   "神迹"
  ],
  "text": "显出神的能力、指明耶稣是谁的奇事。"
 },
 {
  "id": "money-changer",
  "terms": [
   "兑换银钱"
  ],
  "text": "把各国钱币换成圣殿通用钱币的商人，从中加价牟利。"
 },
 {
  "id": "son-of-man",
  "terms": [
   "人子"
  ],
  "text": "意思是“人的儿子”，是耶稣常用来称呼自己的名号，令人想起但以理书中那位天上的掌权者。"
 },
 {
  "id": "pharisee",
  "terms": [
   "法利赛"
  ],
  "text": "犹太教的一派，严格遵守律法和祖宗的传统，常与耶稣起冲突。"
 },
 {
  "id": "samaritan",
  "terms": [
   "撒马利亚人"
  ],
  "text": "住在犹太和加利利之间撒马利亚地区的人。他们与犹太人长期不和，彼此不相往来。"
 },
 {
  "id": "seventh-hour",
  "terms": [
   "未时"
  ],
  "text": "原文是“第七个时辰”，从日出算起，约为今天下午一点。"
 },
 {
  "id": "sabbath",
  "terms": [
   "安息日"
  ],
  "text": "一周的第七天，停下工作、记念神的圣日，从星期五日落到星期六日落。"
 },
 {
  "id": "synagogue",
  "terms": [
   "会堂"
  ],
  "text": "犹太人在各城各村聚集读经、祷告和学习的地方。"
 },
 {
  "id": "synagogue-ruler",
  "terms": [
   "管会堂"
  ],
  "text": "负责主持会堂聚会和礼拜的人。"
 },
 {
  "id": "scroll",
  "terms": [
   "书卷"
  ],
  "text": "把皮子或蒲草纸接成长条卷起来的书。圣经当时也是这样写成的。"
 },
 {
  "id": "unclean-spirit",
  "terms": [
   "污灵"
  ],
  "text": "抓住人、折磨人的恶灵。耶稣用一句话就把它们赶出去。"
 },
 {
  "id": "paralytic",
  "terms": [
   "瘫子"
  ],
  "text": "身体瘫痪、不能动弹的病人。"
 },
 {
  "id": "tax-collector",
  "terms": [
   "税吏",
   "税吏长",
   "税关"
  ],
  "text": "替罗马向同胞收税的人。常多收中饱私囊，被人当作罪人看待。"
 },
 {
  "id": "colonnade",
  "terms": [
   "廊子",
   "廊下"
  ],
  "text": "用柱子撑着屋顶、一边或两边敞开的长廊。"
 },
 {
  "id": "apostle",
  "terms": [
   "使徒"
  ],
  "text": "意思是“奉差遣的人”，指耶稣拣选设立的十二个门徒。",
  "skip": [
   "使徒行传"
  ]
 },
 {
  "id": "zealot",
  "terms": [
   "奋锐党"
  ],
  "text": "属于一个犹太群体，主张哪怕动用武力也要推翻罗马统治。"
 },
 {
  "id": "rock",
  "terms": [
   "磐石"
  ],
  "text": "又大又坚固的岩石，比喻不动摇的根基。“彼得”这个名字的意思也是“石头”。"
 },
 {
  "id": "inner-room",
  "terms": [
   "内屋"
  ],
  "text": "房子深处的小房间，指避开别人眼目、独自祷告的地方。"
 },
 {
  "id": "centurion",
  "terms": [
   "百夫长"
  ],
  "text": "罗马军队中统领约一百名士兵的军官。"
 },
 {
  "id": "elder",
  "terms": [
   "长老"
  ],
  "text": "带领村镇或百姓的年长领袖。"
 },
 {
  "id": "perfume",
  "terms": [
   "香膏",
   "哪哒"
  ],
  "text": "有香气的贵重油膏。哪哒是用喜马拉雅山区的草制成的极昂贵香膏。"
 },
 {
  "id": "alabaster",
  "terms": [
   "玉瓶"
  ],
  "text": "盛香膏用的光滑石瓶，打破瓶颈一次倒出。"
 },
 {
  "id": "denarius",
  "terms": [
   "两银子"
  ],
  "text": "原文是“得拿利”，罗马银币，约等于工人一天的工钱。"
 },
 {
  "id": "forgive-debt",
  "terms": [
   "都免了",
   "免了一大笔债"
  ],
  "text": "把该还的债减免或一笔勾销。"
 },
 {
  "id": "stern",
  "terms": [
   "船尾"
  ],
  "text": "船的后部。"
 },
 {
  "id": "bleeding",
  "terms": [
   "血漏"
  ],
  "text": "流血不止的病。按律法被视为不洁，难以与人来往。"
 },
 {
  "id": "manna",
  "terms": [
   "吗哪"
  ],
  "text": "以色列人在旷野四十年间，神每天从天上降下的食物。"
 },
 {
  "id": "greek-gentile",
  "terms": [
   "希利尼",
   "外邦"
  ],
  "text": "“希利尼”是希腊的旧称；“外邦”指犹太人以外的民族或他们的地方。"
 },
 {
  "id": "booths",
  "terms": [
   "住棚节"
  ],
  "text": "秋收之后的七日节期，人们住在树枝搭的棚里，记念旷野的日子。"
 },
 {
  "id": "adultery",
  "terms": [
   "行淫"
  ],
  "text": "已婚的人与配偶以外的人发生性关系。律法对此惩罚很重。"
 },
 {
  "id": "condemn",
  "terms": [
   "定你罪",
   "定你的罪"
  ],
  "text": "判定一个人有罪并加以惩罚。"
 },
 {
  "id": "hanukkah",
  "terms": [
   "修殿节"
  ],
  "text": "记念夺回被希腊君王玷污的圣殿、重新献给神的冬季节日，就是今天的光明节。"
 },
 {
  "id": "carob",
  "terms": [
   "豆荚"
  ],
  "text": "豆荚形状的果实，多用来喂猪和牲畜，是穷困到极点时才吃的东西。"
 },
 {
  "id": "silver-coin",
  "terms": [
   "银钱"
  ],
  "text": "用银子铸的钱币。这里指德拉克马，约合一天的工钱。"
 },
 {
  "id": "sanhedrin",
  "terms": [
   "公会"
  ],
  "text": "由大祭司带领的犹太最高议会，也是审判机构。"
 },
 {
  "id": "resurrection",
  "terms": [
   "复活"
  ],
  "text": "死去的人重新活过来。耶稣的复活是基督教信仰的中心。"
 },
 {
  "id": "commandment",
  "terms": [
   "诫命"
  ],
  "text": "神吩咐人遵守的教导，十诫是其中的代表。"
 },
 {
  "id": "sycamore",
  "terms": [
   "桑树"
  ],
  "text": "一种像无花果的树，枝干低矮而伸展，很容易攀爬。"
 },
 {
  "id": "leprosy",
  "terms": [
   "麻风"
  ],
  "text": "一种损伤皮肤的严重皮肤病。圣经时代被视为不洁，患者要住在村外。"
 },
 {
  "id": "pound",
  "terms": [
   "一斤",
   "一百斤"
  ],
  "text": "重量单位。这里的一斤指罗马的“litra”，约三百三十克。"
 },
 {
  "id": "palm",
  "terms": [
   "棕树"
  ],
  "text": "就是枣椰树，人们挥动它的枝子表示胜利和欢迎。"
 },
 {
  "id": "hosanna",
  "terms": [
   "和散那"
  ],
  "text": "希伯来话，意思是“求你现在拯救”，后来成了欢迎和赞美的呼声。"
 },
 {
  "id": "herodian",
  "terms": [
   "希律党"
  ],
  "text": "支持希律家族统治的犹太人群体，赞成向罗马纳税。"
 },
 {
  "id": "sadducee",
  "terms": [
   "撒都该"
  ],
  "text": "与大祭司家族亲近的犹太教一派，不信复活和天使。"
 },
 {
  "id": "treasury",
  "terms": [
   "银库"
  ],
  "text": "放在圣殿院中、供人投入奉献的喇叭形箱子。"
 },
 {
  "id": "talent",
  "terms": [
   "所领的银子"
  ],
  "text": "原文是“他连得”，很大的钱币单位，相当于工人将近二十年的工钱。英文“才能”一词就由此而来。"
 },
 {
  "id": "unleavened",
  "terms": [
   "除酵节"
  ],
  "text": "紧接逾越节的七天节期，吃无酵饼记念出埃及。"
 },
 {
  "id": "passover",
  "terms": [
   "逾越节"
  ],
  "text": "记念在埃及时死亡越过以色列人的家、以及出埃及的最大春季节日。"
 },
 {
  "id": "upper-room",
  "terms": [
   "楼房"
  ],
  "text": "房子楼上的大房间，耶稣在这里与门徒吃了最后的晚餐。"
 },
 {
  "id": "covenant",
  "terms": [
   "立约"
  ],
  "text": "神与人所立坚定的约。耶稣用自己的血立了新约。"
 },
 {
  "id": "hymn",
  "terms": [
   "唱了诗"
  ],
  "text": "赞美神的歌。逾越节晚餐结束时要唱诗篇。"
 },
 {
  "id": "governor",
  "terms": [
   "巡抚"
  ],
  "text": "罗马皇帝派去治理一个地区的官员。彼拉多就是犹太的巡抚。"
 },
 {
  "id": "cross",
  "terms": [
   "十字架"
  ],
  "text": "罗马处死犯人的刑具，是最残酷、最羞辱的死刑。"
 },
 {
  "id": "purple",
  "terms": [
   "紫袍"
  ],
  "text": "紫色的袍子，是君王穿的昂贵衣服。士兵给耶稣穿上，嘲笑他是王。"
 },
 {
  "id": "paradise",
  "terms": [
   "乐园"
  ],
  "text": "已死的义人与神同在的福乐之地。"
 },
 {
  "id": "veil",
  "terms": [
   "幔子"
  ],
  "text": "圣殿里遮住至圣所的厚幔，象征隔开神与人的屏障。"
 },
 {
  "id": "linen",
  "terms": [
   "细麻布"
  ],
  "text": "用亚麻织成的细布，用来包裹遗体。"
 },
 {
  "id": "first-day",
  "terms": [
   "七日的头一日"
  ],
  "text": "安息日的第二天，就是今天的星期日。耶稣在这一天复活。"
 },
 {
  "id": "stadion",
  "terms": [
   "二十五里"
  ],
  "text": "原文是六十“斯他迪”（一斯他迪约一百八十五米），约十一公里。"
 },
 {
  "id": "fourth-watch",
  "terms": [
   "四更"
  ],
  "text": "把夜晚分成四段的第四段，约在凌晨三点到六点。"
 },
 {
  "id": "authority",
  "terms": [
   "权柄"
  ],
  "text": "治理和发令的能力与资格。"
 },
 {
  "id": "righteous",
  "terms": [
   "义人"
  ],
  "text": "在神面前被算为正直的人。这里也带有讽刺自以为义之人的意思。"
 },
 {
  "id": "holy-city",
  "terms": [
   "圣城"
  ],
  "text": "指有神圣殿的耶路撒冷。"
 },
 {
  "id": "kingdom-of-god",
  "terms": [
   "神的国",
   "天国"
  ],
  "text": "神作王掌权的国度。重点不在地方，而在神的统治得以实现。"
 },
 {
  "id": "eternal-life",
  "terms": [
   "永生"
  ],
  "text": "不只是永远活着，而是与神同享的真生命。"
 },
 {
  "id": "leaven",
  "terms": [
   "面酵"
  ],
  "text": "使面团发起来的酵母，比喻微小的东西能遍及全团的力量。"
 },
 {
  "id": "mustard-seed",
  "terms": [
   "芥菜种"
  ],
  "text": "非常小的种子，长大后却比人还高。"
 },
 {
  "id": "feast",
  "terms": [
   "节期",
   "过节"
  ],
  "text": "这里指犹太人上耶路撒冷守的节日，如逾越节、住棚节等。"
 },
 {
  "id": "talitha",
  "terms": [
   "大利大古米",
   "以法大"
  ],
  "text": "耶稣时代犹太人说的亚兰话。“大利大古米”意思是“闺女，起来”，“以法大”意思是“开了吧”。"
 },
 {
  "id": "ransom",
  "terms": [
   "赎价"
  ],
