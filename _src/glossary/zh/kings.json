[
 {
  "id": "high-place",
  "terms": [
   "丘坛"
  ],
  "text": "设在山上或丘陵上的祭坛。圣殿建成以后，这些地方容易与拜偶像混杂，先知们屡次责备。"
 },
 {
  "id": "burnt-offering",
  "terms": [
   "燔祭"
  ],
  "text": "把牲畜整个放在坛上烧掉献给神的祭，表示完全献上。"
 },
 {
  "id": "peace-offering",
  "terms": [
   "平安祭"
  ],
  "text": "为表达与神和好并感恩而献的祭。一部分烧在坛上，其余由献祭的人一同吃。"
 },
 {
  "id": "sacrifice",
  "terms": [
   "献祭"
  ],
  "text": "献上牲畜或谷物来事奉神的敬拜，由祭司在指定的地方主持。"
 },
 {
  "id": "ark",
  "terms": [
   "约柜"
  ],
  "text": "存放刻着神之约的石版、包着金子的木柜，表明神在百姓中间。"
 },
 {
  "id": "cherub",
  "terms": [
   "基路伯"
  ],
  "text": "圣经中指守在神身边、有翅膀的天使。约柜上和至圣所里都刻有它们的形象。"
 },
 {
  "id": "holy-of-holies",
  "terms": [
   "至圣所"
  ],
  "text": "圣殿最里面、安放约柜的至圣之处。只有大祭司每年可以进去一次。"
 },
 {
  "id": "sanctuary",
  "terms": [
   "圣所"
  ],
  "text": "分别出来献给神的圣洁之地，就是圣殿。"
 },
 {
  "id": "covenant",
  "terms": [
   "我的约",
   "立约"
  ],
  "text": "神与百姓所立的约：神保守百姓，百姓单单事奉神。"
 },
 {
  "id": "covenant-book",
  "terms": [
   "约书",
   "律法书"
  ],
  "text": "记载神借着摩西所赐律法的书。约西亚时在圣殿里重新找到并宣读。"
 },
 {
  "id": "law",
  "terms": [
   "律法"
  ],
  "text": "神借着摩西赐给以色列的教导和律例，是敬拜和生活的准则。"
 },
 {
  "id": "commandment",
  "terms": [
   "诫命"
  ],
  "text": "神吩咐人遵守的教导，以十诫为中心。"
 },
 {
  "id": "prophet",
  "terms": [
   "先知"
  ],
  "text": "领受神的话、传给君王和百姓的人。"
 },
 {
  "id": "man-of-god",
  "terms": [
   "神人"
  ],
  "text": "对神所差派之先知的尊称。"
 },
 {
  "id": "prophets-sons",
  "terms": [
   "先知门徒",
   "先知的门徒"
  ],
  "text": "聚集在先知身边一同学习、一同生活的人。以利亚和以利沙的时代各地都有。"
 },
 {
  "id": "prophecy",
  "terms": [
   "预言"
  ],
  "text": "先知从神领受并传讲的话。有时预告将来，但更多是警告人现在就要回转。"
 },
 {
  "id": "priest",
  "terms": [
   "祭司"
  ],
  "text": "在圣殿主持献祭、在神与百姓之间事奉的人。原本只由利未支派中亚伦的后代担任。"
 },
 {
  "id": "high-priest",
  "terms": [
   "大祭司"
  ],
  "text": "祭司的首领，每年一次进入至圣所为百姓赎罪。"
 },
 {
  "id": "levite",
  "terms": [
   "利未人"
  ],
  "text": "被分别出来负责圣殿事务的利未支派的人。耶罗波安违背这规定，随便立人作祭司。"
 },
 {
  "id": "tribe",
  "terms": [
   "支派"
  ],
  "text": "从雅各十二个儿子分出来的以色列大宗族。国家由十二个支派组成。"
 },
 {
  "id": "incense",
  "terms": [
   "烧香"
  ],
  "text": "焚烧香料献给神明。香烟象征祷告上升。"
 },
 {
  "id": "spices",
  "terms": [
   "香料"
  ],
  "text": "能发出香气的贵重树脂和香料，是从远方用骆驼运来的昂贵货物。"
 },
 {
  "id": "talent",
  "terms": [
   "他连得"
  ],
  "text": "很重的重量单位，一他连得约三十四公斤。一他连得金子是一大笔财富。"
 },
 {
  "id": "shekel",
  "terms": [
   "舍客勒"
  ],
  "text": "重量和货币单位，一舍客勒约十一克，主要用来称银子。"
 },
 {
  "id": "seah",
  "terms": [
   "一细亚"
  ],
  "text": "量谷物的容量单位，一细亚约七升。"
 },
 {
  "id": "baal",
  "terms": [
   "巴力"
  ],
  "text": "迦南人相信掌管雨水和风暴的神。亚哈和耶洗别时在以色列广为流行。"
 },
 {
  "id": "asherah",
  "terms": [
   "亚舍拉"
  ],
  "text": "迦南的女神，人们立木柱或木像作她的象征来供奉。"
 },
 {
  "id": "pillar",
  "terms": [
   "柱像"
  ],
  "text": "作为拜偶像标记而立的石柱。律法吩咐不可立这些，还要打碎它们。"
 },
 {
  "id": "idol",
  "terms": [
   "偶像"
  ],
  "text": "人用木头、石头或金属做成、当作神来供奉的像。圣经把这看作离弃神的罪。"
 },
 {
  "id": "golden-calf",
  "terms": [
   "金牛犊"
  ],
  "text": "用金子做的牛犊像。在旷野和耶罗波安时代，人们都拜它代替神，成了大罪。"
 },
 {
  "id": "bronze-serpent",
  "terms": [
   "铜蛇"
  ],
  "text": "摩西在旷野挂在杆子上、使百姓得活的铜蛇。后来人们把它当偶像供奉，希西家就把它打碎了。"
 },
 {
  "id": "bronze-sea",
  "terms": [
   "铜海"
  ],
  "text": "放在所罗门圣殿院子里的大铜水池，盛着祭司洗身用的水。"
 },
 {
  "id": "wrath",
  "terms": [
   "向所罗门发怒",
   "惹主发怒",
   "主的怒气"
  ],
  "text": "神看见罪而大大发怒。"
 },
 {
  "id": "sign",
  "terms": [
   "兆头"
  ],
  "text": "证明神所说的话真实的奇事，也叫神迹。"
 },
 {
  "id": "gentile",
  "terms": [
   "外邦"
  ],
  "text": "指以色列以外的其他民族。"
 },
 {
  "id": "assembly",
  "terms": [
   "会众"
  ],
  "text": "为事奉神而聚在一起的全体百姓。"
 },
 {
  "id": "scorpion-whip",
  "terms": [
   "蝎子鞭"
  ],
  "text": "一般认为是带铁片或尖刺、打人极痛的鞭子，意思是要更严酷地管治。"
 },
 {
  "id": "chariot",
  "terms": [
   "战车"
  ],
  "text": "用马拉的作战车辆，是古代军队最强的武器。"
 },
 {
  "id": "horsemen",
  "terms": [
   "马兵"
  ],
  "text": "骑马的士兵。“战车和马兵”比喻保卫国家的力量。"
 },
 {
  "id": "yoke-of-oxen",
  "terms": [
   "对牛"
  ],
  "text": "两头牛同负一轭、一起拉犁，算作一对。"
 },
 {
  "id": "sackcloth",
  "terms": [
   "麻布"
  ],
  "text": "用粗毛织成的衣服，穿上表示悲伤或悔改。"
 },
 {
  "id": "fast",
  "terms": [
   "禁食"
  ],
  "text": "在一段时间内不吃东西，专心恳求神，表示悲伤或悔改。"
 },
 {
  "id": "threshing-floor",
  "terms": [
   "禾场"
  ],
  "text": "把谷穗打下颗粒的宽阔平地，也用作城门旁聚会的地方。"
 },
 {
  "id": "gird",
  "terms": [
   "束上腰"
  ],
  "text": "用腰带把长衣襟紧紧束起，表示准备好奔跑或做工。"
 },
 {
  "id": "still-small",
  "terms": [
   "微小"
  ],
  "text": "极其轻细的声音。以利亚不是在烈风中，而是在微小的声音里遇见神。"
 },
 {
  "id": "leprosy",
  "terms": [
   "麻风"
  ],
  "text": "圣经中的麻风不只是今天的汉森病，也包括各种严重的皮肤病。患者要住在村外。"
 },
 {
  "id": "commander",
  "terms": [
   "元帅"
  ],
  "text": "统领军队的高级将领。"
 },
 {
  "id": "beam",
  "terms": [
   "一根木头"
  ],
  "text": "架在柱子之间、支撑屋顶的粗大木料。"
 },
 {
  "id": "inner-room",
  "terms": [
   "内室"
  ],
  "text": "大房间后面附带的小房间，可以避开别人的眼目。"
 },
 {
  "id": "watchman",
  "terms": [
   "守望者"
  ],
  "text": "在城墙或望楼上守望、保卫城池的人。"
 },
 {
  "id": "watchtower",
  "terms": [
   "望楼"
  ],
  "text": "为了远望守卫而建的高台。"
 },
 {
  "id": "harlotry",
  "terms": [
   "淫行"
  ],
  "text": "婚姻以外的性方面的罪。圣经也用它来比喻拜偶像。"
 },
 {
  "id": "sorcery",
  "terms": [
   "邪术"
  ],
  "text": "使用咒语、占卜等法术，是律法所禁止的。"
 },
 {
  "id": "eunuch",
  "terms": [
   "太监"
  ],
  "text": "在王宫里贴身服侍君王和王后的官员。"
 },
 {
  "id": "centurion",
  "terms": [
   "百夫长"
  ],
  "text": "统领约一百名士兵的军官。"
 },
 {
  "id": "throne",
  "terms": [
   "宝座"
  ],
  "text": "君王坐的位子，象征君王的权柄。"
 },
 {
  "id": "scribe",
  "terms": [
   "书记"
  ],
  "text": "负责书写和记录的官员，在这个时代是掌管王宫文书的高官。"
 },
 {
  "id": "recorder",
  "terms": [
   "史官"
  ],
  "text": "记录并宣布王宫事务的官员。"
 },
 {
  "id": "aramaic",
  "terms": [
   "亚兰话"
  ],
  "text": "亚兰人的语言。当时是各国外交官通用的语言，一般犹大百姓听不太懂。"
 },
 {
  "id": "blaspheme",
  "terms": [
   "亵渎"
  ],
  "text": "侮辱或轻视神的言语和行为。"
 },
 {
  "id": "zion",
  "terms": [
   "锡安"
  ],
  "text": "耶路撒冷的别称，特别指圣殿所在的山，象征神居住的地方。"
 },
 {
  "id": "angel-of-lord",
  "terms": [
   "主的使者"
  ],
  "text": "神差来的天使，传达或执行神的旨意。"
 },
 {
  "id": "passover",
  "terms": [
   "逾越节"
  ],
  "text": "记念在埃及蒙拯救那一夜的以色列最大节日，全家一同宰羊吃。"
 },
 {
  "id": "judges",
  "terms": [
   "士师"
  ],
  "text": "在设立君王以前带领以色列的领袖，是神在危难时兴起的。"
 },
 {
  "id": "medium",
  "terms": [
   "交鬼"
  ],
  "text": "自称能招来死人的魂来占卜的人，律法严厉禁止。"
 },
 {
  "id": "guard-captain",
  "terms": [
   "护卫长"
  ],
  "text": "保卫君王的军队首领。"
 },
 {
  "id": "siege-ramp",
  "terms": [
   "土垒"
  ],
  "text": "攻城时一直堆到城墙边的土堤，上面可以推上攻城器械。"
 },
 {
  "id": "tribulation",
  "terms": [
   "急难"
  ],
  "text": "极其痛苦艰难的事。"
 }
]