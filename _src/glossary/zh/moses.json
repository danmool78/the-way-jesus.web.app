[
 {
  "id": "store-city",
  "terms": [
   "积货城"
  ],
  "text": "囤积国家粮食和物资的城。以色列人像奴隶一样被驱使去建造这些城。"
 },
 {
  "id": "midwife",
  "terms": [
   "接生婆"
  ],
  "text": "在妇人生产时在旁接生的女人，类似今天的助产士。"
 },
 {
  "id": "bitumen",
  "terms": [
   "石漆"
  ],
  "text": "从地里出产的黏稠黑色油块，就是沥青。涂在箱子或船上防止漏水。"
 },
 {
  "id": "priest",
  "terms": [
   "祭司"
  ],
  "text": "向神献祭、为百姓祷告并教导律法的人。"
 },
 {
  "id": "high-priest",
  "terms": [
   "大祭司"
  ],
  "text": "祭司中的首领。亚伦最先担任，由他的儿子们代代承接。"
 },
 {
  "id": "bush",
  "terms": [
   "荆棘"
  ],
  "text": "旷野中生长的低矮带刺灌木。神在这丛荆棘的火焰中呼召摩西。"
 },
 {
  "id": "sign",
  "terms": [
   "神迹"
  ],
  "text": "显明神与人同在的奇妙之事。不只是奇迹，更是指向某种意义的记号。"
 },
 {
  "id": "feast",
  "terms": [
   "守节"
  ],
  "text": "在指定的时候聚集、记念神而守的节日，如逾越节、住棚节等。"
 },
 {
  "id": "magician",
  "terms": [
   "术士"
  ],
  "text": "在法老宫中施行神秘法术的人。起初几样灾他们还能模仿，很快就认输了。"
 },
 {
  "id": "passover",
  "terms": [
   "逾越节"
  ],
  "text": "意思是“越过”，是以色列的第一个节日，记念灾祸越过涂了羔羊血之家的那一夜。"
 },
 {
  "id": "hyssop",
  "terms": [
   "牛膝草"
  ],
  "text": "长在石缝间的小草，捆成一束用来蘸血或水洒。"
 },
 {
  "id": "lintel",
  "terms": [
   "门楣"
  ],
  "text": "横架在门上方的木头。逾越节那夜，人们把羔羊的血涂在这里和左右门框上。"
 },
 {
  "id": "leaven",
  "terms": [
   "无酵饼"
  ],
  "text": "酵是使面团发起来的酵母。他们匆忙离开，吃了没有酵的饼，后来就成了除酵节。"
 },
 {
  "id": "able-men",
  "terms": [
   "壮丁"
  ],
  "text": "能上战场的成年男子，妇女和孩子不算在这个数目里。"
 },
 {
  "id": "chariot",
  "terms": [
   "战车"
  ],
  "text": "用马拉的作战车辆，是当时最可怕的武器。"
 },
 {
  "id": "prophet",
  "terms": [
   "先知"
  ],
  "text": "领受神的话并传给人的人，不只是预言将来的人。"
 },
 {
  "id": "statutes",
  "terms": [
   "律例典章"
  ],
  "text": "神为百姓定下、要他们遵守的法度和规则。"
 },
 {
  "id": "omer",
  "terms": [
   "俄梅珥"
  ],
  "text": "量粮食的单位，约两升，是一个人一天吃的吗哪的分量。"
 },
 {
  "id": "manna",
  "terms": [
   "吗哪"
  ],
  "text": "神在旷野天天降下的食物。名字来自“这是什么”的问话。"
 },
 {
  "id": "sabbath",
  "terms": [
   "安息日"
  ],
  "text": "第七天，停工安息、记念神的日子，从今天的星期五日落到星期六日落。"
 },
 {
  "id": "elder",
  "terms": [
   "长老"
  ],
  "text": "代表家族和支派的年长领袖，一同商议、判断百姓的事。"
 },
 {
  "id": "burnt-offering",
  "terms": [
   "燔祭"
  ],
  "text": "把祭牲整个烧掉献上的祭，表示完全献给神。"
 },
 {
  "id": "peace-offering",
  "terms": [
   "平安祭"
  ],
  "text": "因神与人和好而欢喜献上的祭，祭肉的一部分大家一同分吃。"
 },
 {
  "id": "lawsuit",
  "terms": [
   "案件"
  ],
  "text": "起了纠纷，请人判明是非曲直，类似今天的诉讼审判。"
 },
 {
  "id": "covenant",
  "terms": [
   "我的约",
   "立约"
  ],
  "text": "神与百姓所立坚定的约：他要作他们的神，他们要作他的子民。"
 },
 {
  "id": "purify",
  "terms": [
   "洁净"
  ],
  "text": "为了来到神面前而洗净身体和衣服，用外面的洁净表明内心的预备。"
 },
 {
  "id": "graven-image",
  "terms": [
   "雕刻偶像"
  ],
  "text": "用木头、石头或金属雕成的神像。为了供奉而造的这类东西叫作偶像。"
 },
 {
  "id": "adultery",
  "terms": [
   "奸淫"
  ],
  "text": "已婚的人与配偶以外的人发生性关系。"
 },
 {
  "id": "sapphire",
  "terms": [
   "蓝宝石"
  ],
  "text": "蓝色的宝石，一般认为是蓝宝石或青金石。"
 },
 {
  "id": "tablets",
  "terms": [
   "石版"
  ],
  "text": "神刻上十诫的两块石版，后来放在约柜里。"
 },
 {
  "id": "tabernacle",
  "terms": [
   "帐幕"
  ],
  "text": "在旷野中随走随立的帐篷圣殿，表明神住在百姓中间。"
 },
 {
  "id": "tent-of-meeting",
  "terms": [
   "会幕"
  ],
  "text": "神与摩西和百姓相会的帐幕，是帐幕的另一个名称。"
 },
 {
  "id": "testimony",
  "terms": [
   "法版"
  ],
  "text": "刻着十诫的石版，因为见证神与百姓之间的约，所以这样称呼。"
 },
 {
  "id": "ark",
  "terms": [
   "约柜",
   "法柜"
  ],
  "text": "存放石版、包着金子的木柜，表明神在百姓中间，由祭司抬着行走。"
 },
 {
  "id": "mercy-seat",
  "terms": [
   "施恩座"
  ],
  "text": "盖在约柜上的金盖。大祭司每年在这里洒血，为百姓赎罪。"
 },
 {
  "id": "veil",
  "terms": [
   "幔子"
  ],
  "text": "隔开空间的厚帘子，在帐幕里遮住至圣所。"
 },
 {
  "id": "showbread-table",
  "terms": [
   "陈设饼"
  ],
  "text": "帐幕里在神面前常摆十二个饼的桌子。"
 },
 {
  "id": "lampstand",
  "terms": [
   "灯台"
  ],
  "text": "有七个分枝、点着灯的金灯台，常常照亮帐幕里面。"
 },
 {
  "id": "incense-altar",
  "terms": [
   "香坛"
  ],
  "text": "帐幕里早晚烧香用的小金坛。"
 },
 {
  "id": "bronze-altar",
  "terms": [
   "燔祭坛"
  ],
  "text": "放在帐幕院子里的大铜坛，在这里焚烧祭牲献祭。"
 },
 {
  "id": "laver",
  "terms": [
   "洗濯盆"
  ],
  "text": "祭司洗手洗脚用的大铜盆。"
 },
 {
  "id": "days-journey",
  "terms": [
   "一天的路程"
  ],
  "text": "一天能走的距离，约三十公里。"
 },
 {
  "id": "spy",
  "terms": [
   "探子",
   "窥探"
  ],
  "text": "偷偷进入敌方的地，察看情形后回来的人。"
 },
 {
  "id": "tribe",
  "terms": [
   "支派"
  ],
  "text": "从雅各十二个儿子分出来的大宗族。以色列由十二个支派组成。"
 },
 {
  "id": "censer",
  "terms": [
   "香炉"
  ],
  "text": "盛炭火烧香的器皿，只有祭司可以在神面前使用。"
 },
 {
  "id": "plague",
  "terms": [
   "瘟疫"
  ],
  "text": "在人群中蔓延的可怕传染病。"
 },
 {
  "id": "bronze-serpent",
  "terms": [
   "铜蛇"
  ],
  "text": "用铜做的蛇。仰望它的人就得活。耶稣把自己的十字架比作这铜蛇。"
 },
 {
  "id": "divination-fee",
  "terms": [
   "卦金"
  ],
  "text": "请人占卜或祝福、咒诅时所付的钱财或礼物。"
 },
 {
  "id": "official",
  "terms": [
   "使臣"
  ],
  "text": "在国中身居高位、奉命出使的人。"
 },
 {
  "id": "law",
  "terms": [
   "律法书",
   "律法"
  ],
  "text": "神借着摩西赐下的教导和诫命。律法书就是记载这些的书。"
 },
 {
  "id": "doorpost",
  "terms": [
   "门框"
  ],
  "text": "门两边立着的柱子。"
 },
 {
  "id": "flax",
  "terms": [
   "麻秸"
  ],
  "text": "用来织布的亚麻的茎秆，铺在屋顶上晾干。"
 },
 {
  "id": "ford",
  "terms": [
   "渡口"
  ],
  "text": "可以涉水过河的浅处，或靠船的地方。"
 },
 {
  "id": "circumcision",
  "terms": [
   "割礼"
  ],
  "text": "割去男孩包皮的仪式，是作神子民的立约记号。"
 },
 {
  "id": "shofar",
  "terms": [
   "羊角号",
   "角声"
  ],
  "text": "用公羊角做的号（希伯来语叫“朔法”），在节期、打仗和宣告大事时吹响。"
 },
 {
  "id": "devoted",
  "terms": [
   "当灭"
  ],
  "text": "意思是全部毁灭，不归人所有，而是完全交给神。"
 },
 {
  "id": "peace-treaty",
  "terms": [
   "讲和"
  ],
  "text": "彼此约定不再争战，和睦相处。"
 },
 {
  "id": "inheritance",
  "terms": [
   "产业"
  ],
  "text": "神赐下、让人世世代代承受的份，也就是遗产。"
 },
 {
  "id": "office",
  "terms": [
   "职分"
  ],
  "text": "所担当的工作和随之而来的职位。"
 },
 {
  "id": "oak",
  "terms": [
   "橡树"
  ],
  "text": "结橡子的高大树木，常成为记念大事的地方。"
 },
 {
  "id": "sanctuary",
  "terms": [
   "圣所"
  ],
  "text": "敬拜神的圣洁之处。"
 },
 {
  "id": "wrath",
  "terms": [
   "怒气",
   "发怒"
  ],
  "text": "神对罪圣洁的愤怒。"
 },
 {
  "id": "lovingkindness",
  "terms": [
   "慈爱"
  ],
  "text": "神始终不变、紧紧扶持的爱与怜悯。"
 },
 {
  "id": "worship",
  "terms": [
   "伏地下拜"
  ],
  "text": "俯伏在地、尊崇神。"
 }
]