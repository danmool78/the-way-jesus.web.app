[
 {
  "id": "prophet",
  "terms": [
   "先知"
  ],
  "text": "领受神的旨意并传给人的人。撒母耳、迦得、拿单都曾在大卫身边担当这职分。"
 },
 {
  "id": "anoint",
  "terms": [
   "盛油的角"
  ],
  "text": "把橄榄油倒在人头上，表示神拣选这人作王或祭司。"
 },
 {
  "id": "priest",
  "terms": [
   "祭司"
  ],
  "text": "在圣所献祭、在神面前代表百姓的人，由亚伦的后代担任。"
 },
 {
  "id": "sacrifice",
  "terms": [
   "献祭"
  ],
  "text": "把牲畜或谷物献给神的敬拜，为求赦罪或表达感谢。"
 },
 {
  "id": "burnt-offering",
  "terms": [
   "燔祭"
  ],
  "text": "把祭物在坛上整个烧掉献给神的祭，表示完全献上。"
 },
 {
  "id": "peace-offering",
  "terms": [
   "平安祭"
  ],
  "text": "因神与人和好而欢喜献上的祭，祭肉的一部分大家一同分吃。"
 },
 {
  "id": "offering",
  "terms": [
   "为祭"
  ],
  "text": "献祭时献给神的牲畜、谷物等礼物。"
 },
 {
  "id": "shekel",
  "terms": [
   "舍客勒"
  ],
  "text": "重量单位，也是货币单位，一舍客勒约十一克。五千舍客勒的铠甲超过五十公斤。"
 },
 {
  "id": "talent",
  "terms": [
   "他连得"
  ],
  "text": "最大的重量单位，一他连得约三十四公斤，相当于三千舍客勒。"
 },
 {
  "id": "circumcision",
  "terms": [
   "割礼"
  ],
  "text": "割去男婴包皮的仪式，是与神立约之民的记号。"
 },
 {
  "id": "foreskin",
  "terms": [
   "阳皮"
  ],
  "text": "男性生殖器前端的包皮。非利士人不行割礼，所以这可以作为杀了他们的凭据。"
 },
 {
  "id": "teraphim",
  "terms": [
   "家中神像"
  ],
  "text": "放在家里的人形小神像，在以色列是被禁止的偶像。"
 },
 {
  "id": "ephod",
  "terms": [
   "以弗得"
  ],
  "text": "祭司穿的一种背心式圣衣，用来求问神的旨意。大卫借着它向神问路。"
 },
 {
  "id": "sanctuary",
  "terms": [
   "圣所"
  ],
  "text": "敬拜神、献祭的圣洁之处。大卫时代在挪伯。"
 },
 {
  "id": "showbread",
  "terms": [
   "圣饼"
  ],
  "text": "摆在圣所桌上、在神面前的饼，每个安息日换新，只有祭司可以吃。"
 },
 {
  "id": "tabernacle",
  "terms": [
   "会幕"
  ],
  "text": "从旷野时代起用来敬拜神的移动式帐篷圣所，圣殿建成以前一直使用。"
 },
 {
  "id": "tent",
  "terms": [
   "帐幕"
  ],
  "text": "用布搭成的房子，就是帐篷。大卫另外搭了帐幕安放约柜。"
 },
 {
  "id": "curtain",
  "terms": [
   "幔子"
  ],
  "text": "搭成帐篷或遮隔空间的大幅布幔，这里表示约柜还在帐篷里。"
 },
 {
  "id": "ark",
  "terms": [
   "约柜"
  ],
  "text": "存放十诫石版、包着金子的木柜，表明神在百姓中间，不可随意触摸。"
 },
 {
  "id": "temple",
  "terms": [
   "圣殿",
   "主的殿",
   "殿宇"
  ],
  "text": "敬拜神的殿。耶路撒冷的圣殿由大卫预备、他的儿子所罗门建成。"
 },
 {
  "id": "covenant",
  "terms": [
   "立约",
   "盟约"
  ],
  "text": "双方郑重约定要遵守的承诺。神与大卫的家立了永远的约。"
 },
 {
  "id": "lord-of-hosts",
  "terms": [
   "万军之主",
   "万军之神"
  ],
  "text": "意思是统领天上地下一切军队的主，是神的名号。"
 },
 {
  "id": "spirit-of-lord",
  "terms": [
   "主的灵",
   "神的灵"
  ],
  "text": "神的灵。临到人身上，就赐人能力和智慧去做神的工作。"
 },
 {
  "id": "prophesy",
  "terms": [
   "受感说话"
  ],
  "text": "被神的灵感动，传讲或赞美神的话，不只是预言将来。"
 },
 {
  "id": "new-moon",
  "terms": [
   "初一"
  ],
  "text": "农历月份开始的第一天。以色列人在这天献祭、设宴。"
 },
 {
  "id": "sling",
  "terms": [
   "机弦"
  ],
  "text": "把石子放进皮兜里旋转甩出去的武器。牧人也用它赶走野兽。"
 },
 {
  "id": "javelin",
  "terms": [
   "短枪"
  ],
  "text": "便于投掷的短矛。"
 },
 {
  "id": "commander-thousand",
  "terms": [
   "千夫长"
  ],
  "text": "统领一千名士兵的军官。"
 },
 {
  "id": "commander",
  "terms": [
   "元帅"
  ],
  "text": "统领全国军队的最高将领。"
 },
 {
  "id": "chariot",
  "terms": [
   "车辆",
   "有车"
  ],
  "text": "用马拉的作战车辆，也显出君王或王子的威势。"
 },
 {
  "id": "threshing-floor",
  "terms": [
   "禾场"
  ],
  "text": "把收来的谷物打下颗粒的宽阔平地，通常在风大的山坡上。"
 },
 {
  "id": "fine-linen",
  "terms": [
   "细麻布"
  ],
  "text": "用细线织成的白色细布，用来做祭司的衣服。"
 },
 {
  "id": "cedar",
  "terms": [
   "香柏"
  ],
  "text": "黎巴嫩出产的高大树木，木质芳香坚硬，是建造宫殿和圣殿的名贵木材。"
 },
 {
  "id": "tribute",
  "terms": [
   "进贡"
  ],
  "text": "战败的国家每年献给战胜国的财物。"
 },
 {
  "id": "counselor",
  "terms": [
   "谋士"
  ],
  "text": "为君王出主意、献计策的人。亚希多弗以智慧出名。"
 },
 {
  "id": "vow",
  "terms": [
   "许愿"
  ],
  "text": "自己向神承诺要做某件事，必须遵守。"
 },
 {
  "id": "lawsuit",
  "terms": [
   "诉讼"
  ],
  "text": "把纠纷交给审判、请求判决。"
 },
 {
  "id": "tamarisk",
  "terms": [
   "垂丝柳"
  ],
  "text": "在干旱之地也长得很好的矮树，又叫柽柳。"
 },
 {
  "id": "fasting",
  "terms": [
   "禁食"
  ],
  "text": "因悲伤或恳切祷告，在一段时间内不吃东西。"
 },
 {
  "id": "worship",
  "terms": [
   "敬拜"
  ],
  "text": "在神面前俯伏，尊崇敬拜他。"
 },
 {
  "id": "law",
  "terms": [
   "律法"
  ],
  "text": "神借着摩西赐下的诫命和律例，记载以色列人生活的道路。"
 },
 {
  "id": "rock",
  "terms": [
   "磐石"
  ],
  "text": "又大又宽的岩石。也用来比喻坚定不移、保护人的神。"
 },
 {
  "id": "tribe",
  "terms": [
   "支派"
  ],
  "text": "从雅各十二个儿子分出来的以色列十二个宗族。"
 },
 {
  "id": "elder",
  "terms": [
   "长老"
  ],
  "text": "带领城邑和支派的年长领袖。"
 },
 {
  "id": "assembly",
  "terms": [
   "会众"
  ],
  "text": "为敬拜或重要的事聚集在一起的全体百姓。"
 },
 {
  "id": "levite",
  "terms": [
   "利未人"
  ],
  "text": "利未支派的人，负责抬运和看守会幕与约柜。"
 },
 {
  "id": "wrath",
  "terms": [
   "向乌撒发怒",
   "主的怒气"
  ],
  "text": "神不放过罪的圣洁愤怒。"
 },
 {
  "id": "wineskin",
  "terms": [
   "皮袋"
  ],
  "text": "用兽皮缝成的袋子，用来装运酒或水。"
 },
 {
  "id": "parched-grain",
  "terms": [
   "烘过的穗子",
   "炒谷"
  ],
  "text": "把麦子或大麦的颗粒烘炒过，便于携带的干粮。"
 },
 {
  "id": "curds",
  "terms": [
   "奶油"
  ],
  "text": "把牲畜的奶凝结做成的食物，类似酸奶或黄油。"
 },
 {
  "id": "bride-price",
  "terms": [
   "聘礼"
  ],
  "text": "新郎给新娘家的礼物。扫罗借此想让大卫陷入危险。"
 },
 {
  "id": "watchman",
  "terms": [
   "守望人"
  ],
  "text": "在城墙或高处守望、通报来人的人。"
 },
 {
  "id": "messenger",
  "terms": [
   "使者"
  ],
  "text": "急速奔跑传递消息或命令的人。"
 },
 {
  "id": "justice",
  "terms": [
   "秉公行义"
  ],
  "text": "持守在神看来正直公平的事。好的君王必须按公义治理。"
 },
 {
  "id": "set-apart",
  "terms": [
   "分别为圣"
  ],
  "text": "从平常的用途中分出来，单单献给神。"
 },
 {
  "id": "decorum",
  "terms": [
   "体面"
  ],
  "text": "与身份相称的举止和威严。"
 },
 {
  "id": "oak",
  "terms": [
   "橡树"
  ],
  "text": "结橡子的高大树木，枝杈宽广交错。"
 },
 {
  "id": "psalm",
  "terms": [
   "诗篇"
  ],
  "text": "收集献给神的诗歌和祷告的圣经书卷，其中有许多是大卫写的。"
 },
 {
  "id": "grace",
  "terms": [
   "施恩"
  ],
  "text": "白白赐给不配得之人的爱和恩待。"
 }
]