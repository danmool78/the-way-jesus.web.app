[
 {
  "id": "elders-gate",
  "terms": [
   "长老"
  ],
  "text": "城里的年长领袖。他们坐在城门旁听人争讼、作出判决，也商议城里的事。"
 },
 {
  "id": "lawsuit",
  "terms": [
   "诉讼"
  ],
  "text": "把纠纷带到官府或审判的地方，请求判决。"
 },
 {
  "id": "fear-of-lord",
  "terms": [
   "敬畏"
  ],
  "text": "既惧怕神又仰望尊崇、事奉他的心。箴言把它看作智慧的开端。"
 },
 {
  "id": "instruction",
  "terms": [
   "训诲"
  ],
  "text": "纠正过错、教人走正路的话。"
 },
 {
  "id": "fool",
  "terms": [
   "愚妄人",
   "愚昧人"
  ],
  "text": "箴言所说的愚人不是头脑不好的人，而是轻视教导、固执己见过日子的人。"
 },
 {
  "id": "rebuke",
  "terms": [
   "责备"
  ],
  "text": "指出过错、叫人改正的话。"
 },
 {
  "id": "understanding",
  "terms": [
   "聪明"
  ],
  "text": "看透事物的道理、分辨是非的悟性。在箴言里常与智慧成对出现。"
 },
 {
  "id": "vineyard",
  "terms": [
   "葡萄园"
  ],
  "text": "栽种、照料葡萄树的田地，是以色列农业的中心。"
 },
 {
  "id": "poverty",
  "terms": [
   "贫穷"
  ],
  "text": "贫困到生活极其艰难的境况。"
 },
 {
  "id": "want",
  "terms": [
   "缺乏"
  ],
  "text": "所有的都用尽了、极其不足而困乏的状态。"
 },
 {
  "id": "weights",
  "terms": [
   "砝码"
  ],
  "text": "放在秤上称东西重量的石块或金属块。有些商人用两套轻重不同的砝码骗人。"
 },
 {
  "id": "favor",
  "terms": [
   "恩宠"
  ],
  "text": "从别人那里得到的好意和喜爱，指在神和人面前蒙悦纳。"
 },
 {
  "id": "loyalty",
  "terms": [
   "忠诚"
  ],
  "text": "心地真实、始终如一，值得信赖。"
 },
 {
  "id": "lattice",
  "terms": [
   "窗棂"
  ],
  "text": "用细木条编成的窗格。从里面能往外看，外面却不容易看进来。"
 },
 {
  "id": "slaughterhouse",
  "terms": [
   "宰杀之地"
  ],
  "text": "宰杀牛、猪等牲畜的地方。"
 },
 {
  "id": "lead-astray",
  "terms": [
   "迷途"
  ],
  "text": "被引诱走上错误的道路，心思被迷惑。"
 },
 {
  "id": "source-of-life",
  "terms": [
   "一生的果效"
  ],
  "text": "原文意思是“生命的泉源”，就是事物发出来的最初源头。"
 },
 {
  "id": "cedar",
  "terms": [
   "香柏"
  ],
  "text": "生长在黎巴嫩、高大而有香气的树木。木质坚硬不朽，所罗门用它建造圣殿和王宫。"
 },
 {
  "id": "watchman",
  "terms": [
   "守卫"
  ],
  "text": "守卫城门、城墙或王宫并负责瞭望的人。"
 },
 {
  "id": "water-channel",
  "terms": [
   "陇沟的水"
  ],
  "text": "为浇灌田地而筑堤引来的水流。比喻神引导王的心，就像人引导水道一样。"
 },
 {
  "id": "needy",
  "terms": [
   "穷乏"
  ],
  "text": "极其贫穷、缺少衣食的境况。"
 },
 {
  "id": "agur",
  "terms": [
   "亚古珥"
  ],
  "text": "留下箴言第三十章话语的智慧人。除了他是雅基的儿子以外，别的都不清楚。"
 },
 {
  "id": "scarlet",
  "terms": [
   "朱红"
  ],
  "text": "深红色。朱红衣服是用贵重染料染成的厚衣，可以御寒。"
 },
 {
  "id": "virtuous-woman",
  "terms": [
   "才德的妇人"
  ],
  "text": "贤良、聪慧、品行端正的妇女。箴言第三十一章歌颂这样的妇人。"
 },
 {
  "id": "lovingkindness",
  "terms": [
   "仁慈"
  ],
  "text": "始终不变地施予的爱与信实，是希伯来话“赫塞德”的翻译。"
 },
 {
  "id": "mixed-wine",
  "terms": [
   "调和"
  ],
  "text": "在酒里调入水或香料，摆在筵席上，表示用心预备了宴席。"
 },
 {
  "id": "holy-one",
  "terms": [
   "至圣者"
  ],
  "text": "对神的称呼，意思是与罪无涉、分别为圣的那一位。"
 },
 {
  "id": "righteous",
  "terms": [
   "义人"
  ],
  "text": "在神面前正直生活的人。"
 }
]