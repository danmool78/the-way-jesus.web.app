{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "README.md", "**/.*", "**/node_modules/**", "_src/**"],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/img/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
