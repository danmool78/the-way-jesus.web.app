{
 "src": "https://pub-7d2b46014d5b4769a48e210890df23c4.r2.dev/psalms/ps60-269606e2cd.mp3",
 "audio": "269606e2cd1015adf38358d69a8a2f1bb079334b589683a10f3b91f6117b335b",
 "by": "auto",
 "lines": [
  {
   "t": 15.3,
   "text": "하나님이여 주께서 우리를 버리셨고"
  },
  {
   "t": 19.1,
   "text": "우리를 흩으시고 노하셨나이다"
  },
  {
   "t": 24,
   "text": "이제 우리를 다시 일으키소서"
  },
  {
   "t": 28.8,
   "text": "땅을 흔들어 갈라지게 하셨으니"
  },
  {
   "t": 33.6,
   "text": "그 틈을 메우소서"
  },
  {
   "t": 38.4,
   "text": "땅이 흔들리나이다"
  },
  {
   "t": 44.1,
   "text": "주께서 백성에게 쓴 일을 보이시고"
  },
  {
   "t": 48.9,
   "text": "비틀거리게 하는 잔을"
  },
  {
   "t": 52.7,
   "text": "우리에게 마시게 하셨나이다"
  },
  {
   "t": 60.4,
   "text": "주를 경외하는 자에게 깃발을 주사"
  },
  {
   "t": 64.3,
   "text": "진리를 위하여 높이 들게 하셨나이다"
  },
  {
   "t": 69.1,
   "text": "주의 사랑하는 자를 건지시려고"
  },
  {
   "t": 73.9,
   "text": "오른손으로 구원하고 응답하소서"
  },
  {
   "t": 84.4,
   "text": "하나님이 그 거룩함으로 말씀하셨네"
  },
  {
   "t": 91.2,
   "text": "길르앗도 내 것이요 므낫세도 내 것이라"
  },
  {
   "t": 95,
   "text": "에브라임은 내 머리의 투구요"
  },
  {
   "t": 99.8,
   "text": "유다는 나의 규로다"
  },
  {
   "t": 106.5,
   "text": "우리를 도와 대적을 치게 하소서"
  },
  {
   "t": 111.3,
   "text": "사람의 구원은 헛되니이다"
  },
  {
   "t": 119,
   "text": "우리가 하나님을 의지하고"
  },
  {
   "t": 123.8,
   "text": "용감하게 나아가리니"
  },
  {
   "t": 128.6,
   "text": "그가 우리의 대적을"
  },
  {
   "t": 132.4,
   "text": "밟으실 이시로다"
  },
  {
   "t": 136.2,
   "text": "하나님을 의지하고"
  },
  {
   "t": 140.1,
   "text": "용감하게 나아가리라"
  }
 ]
}
