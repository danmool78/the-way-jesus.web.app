 "by": "auto",
 "lines": [
  {
   "t": 13.8,
   "text": "여호와는 나의 목자시니"
  },
  {
   "t": 19,
   "text": "내게 부족함이 없으리"
  },
  {
   "t": 25.5,
   "text": "푸른 풀밭에 나를 누이시고"
  },
  {
   "t": 32,
   "text": "쉴 만한 물가로 이끄시네"
  },
  {
   "t": 41.5,
   "text": "내 영혼을 다시 살리시고"
  },
  {
   "t": 45,
   "text": "그 이름을 위하여"
  },
  {
   "t": 48,
   "text": "의로운 길로 나를 이끄시네"
  },
  {
   "t": 54,
   "text": "내가 죽음의 그늘진 골짜기를 지나도"
  },
  {
   "t": 58,
   "text": "해를 두려워 않으리"
  },
  {
   "t": 61,
   "text": "주께서 나와 함께 계시니"
  },
  {
   "t": 65,
   "text": "주의 막대기와 지팡이가 나를 지키네"
  },
  {
   "t": 80,
   "text": "내 원수 앞에서 상을 차려 주시고"
  },
  {
   "t": 85,
   "text": "내 머리에 기름 부으시니"
  },
  {
   "t": 90,
   "text": "내 잔이 넘쳐 흐르네"
  },
  {
   "t": 99,
   "text": "내 평생에 선하심과 인자하심이"
  },
  {
   "t": 105,
   "text": "반드시 나를 따르리니"
  },
  {
   "t": 110,
   "text": "내가 여호와의 집에"
  },
  {
   "t": 115,
   "text": "영원히 살리라"
  },
  {
   "t": 121,
   "text": "여호와의 집에 영원히 살리라"
  }
 ],
 "seek": true
}
