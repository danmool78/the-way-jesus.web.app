 "by": "auto",
 "lines": [
  {
   "t": 17.5,
   "text": "이스라엘이 애굽에서 나올 때"
  },
  {
   "t": 21.5,
   "text": "야곱의 집이 낯선 말의 백성을 떠날 때"
  },
  {
   "t": 27.5,
   "text": "유다는 주의 성소가 되고"
  },
  {
   "t": 31.5,
   "text": "이스라엘은 주의 나라가 되었네"
  },
  {
   "t": 38.5,
   "text": "바다가 보고 도망하고"
  },
  {
   "t": 42.5,
   "text": "요단은 뒤로 물러갔네"
  },
  {
   "t": 47.5,
   "text": "산들은 숫양같이 뛰놀고"
  },
  {
   "t": 52.5,
   "text": "작은 산들은 어린 양같이 뛰었네"
  },
  {
   "t": 59.5,
   "text": "바다야 너는 어찌하여 도망하느냐"
  },
  {
   "t": 104.5,
   "text": "요단아 너는 왜 뒤로 물러가느냐"
  },
  {
   "t": 109.5,
   "text": "산들아 왜 숫양같이 뛰놀며"
  },
  {
   "t": 114.5,
   "text": "작은 산들아 왜 어린 양같이 뛰느냐"
  },
  {
   "t": 120.5,
   "text": "땅이여 주 앞에서 떨어라"
  },
  {
   "t": 125.5,
   "text": "야곱의 하나님 앞에서 떨어라"
  },
  {
   "t": 130.5,
   "text": "반석을 바꾸어 못이 되게 하시고"
  },
  {
   "t": 135.5,
   "text": "차돌을 샘물이 되게 하신 분"
  },
  {
   "t": 141.5,
   "text": "바다가 보고 도망하고"
  },
  {
   "t": 145.5,
   "text": "요단은 뒤로 물러갔네"
  },
  {
   "t": 151.5,
   "text": "산들은 숫양같이 뛰놀고"
  },
  {
   "t": 156.5,
   "text": "작은 산들은 어린 양같이 뛰었네"
  },
  {
   "t": 163.1,
   "text": "야곱의 하나님 앞에서"
  },
  {
   "t": 169.6,
   "text": "~~"
  },
  {
   "t": 176.2,
   "text": "야곱의 하나님 앞에서"
  }
 ]
}
