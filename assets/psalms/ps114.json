 "lines": [
  {
   "t": 17.5,
   "text": "이스라엘이 애굽에서 나올 때"
  },
  {
   "t": 21,
   "text": "야곱의 집이 낯선 말의 백성을 떠날 때"
  },
  {
   "t": 26.5,
   "text": "유다는 주의 성소가 되고"
  },
  {
   "t": 31.5,
   "text": "이스라엘은 주의 나라가 되었네"
  },
  {
   "t": 37,
   "text": "바다가 보고 도망하고"
  },
  {
   "t": 41.5,
   "text": "요단은 뒤로 물러갔네"
  },
  {
   "t": 46.5,
   "text": "산들은 숫양같이 뛰놀고"
  },
  {
   "t": 51.5,
   "text": "작은 산들은 어린 양같이 뛰었네"
  },
  {
   "t": 58.5,
   "text": "바다야 너는 어찌하여 도망하느냐"
  },
  {
   "t": 63.5,
   "text": "요단아 너는 왜 뒤로 물러가느냐"
  },
  {
   "t": 68.5,
   "text": "산들아 왜 숫양같이 뛰놀며"
  },
  {
   "t": 73.5,
   "text": "작은 산들아 왜 어린 양같이 뛰느냐"
  },
  {
   "t": 78.5,
   "text": "땅이여 주 앞에서 떨어라"
  },
  {
   "t": 83.5,
   "text": "야곱의 하나님 앞에서 떨어라"
  },
  {
   "t": 88.5,
   "text": "반석을 바꾸어 못이 되게 하시고"
  },
  {
   "t": 93.5,
   "text": "차돌을 샘물이 되게 하신 분"
  },
  {
   "t": 101.5,
   "text": "바다가 보고 도망하고"
  },
  {
   "t": 105.5,
   "text": "요단은 뒤로 물러갔네"
  },
  {
   "t": 110.5,
   "text": "산들은 숫양같이 뛰놀고"
  },
  {
   "t": 115.5,
   "text": "작은 산들은 어린 양같이 뛰었네"
  },
  {
   "t": 125.5,
   "text": "야곱의 하나님 앞에서"
  },
  {
   "t": 135,
   "text": "~~"
  },
  {
   "t": 161.5,
   "text": "야곱의 하나님 앞에서"
  }
 ]
