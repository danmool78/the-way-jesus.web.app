 "by": "auto",
 "lines": [
  {
   "t": 23,
   "text": "하나님이여 주의 인자를 따라"
  },
  {
   "t": 31.5,
   "text": "나를 불쌍히 여기소서"
  },
  {
   "t": 40,
   "text": "주의 크신 긍휼을 따라"
  },
  {
   "t": 48.5,
   "text": "내 죄악을 지워 주소서"
  },
  {
   "t": 53.5,
   "text": "나는 내 허물을 아오니"
  },
  {
   "t": 58.5,
   "text": "내 죄가 늘 내 앞에 있나이다"
  },
  {
   "t": 107,
   "text": "내가 주께만 죄를 지어"
  },
  {
   "t": 115.5,
   "text": "주 앞에 악을 행하였나이다"
  },
  {
   "t": 123.5,
   "text": "하나님이여 내 안에 정한 마음 지으시고"
  },
  {
   "t": 132,
   "text": "정직한 영을 내 속에 새롭게 하소서"
  },
  {
   "t": 140.5,
   "text": "주 앞에서 나를 내치지 마시며"
  },
  {
   "t": 149,
   "text": "주의 성령을 거두지 마소서"
  },
  {
   "t": 210,
   "text": "우슬초로 나를 정결하게 하소서"
  },
  {
   "t": 216.5,
   "text": "내가 깨끗하리이다"
  },
  {
   "t": 219.5,
   "text": "나를 씻어 주소서"
  },
  {
   "t": 225,
   "text": "내가 눈보다 희리이다"
  },
  {
   "t": 232.5,
   "text": "주의 구원의 기쁨을 다시 주시고"
  },
  {
   "t": 241,
   "text": "기꺼운 영으로 나를 붙드소서"
  },
  {
   "t": 241.8,
   "text": "주께서 원하시는 제사는 상한 마음이라"
  },
  {
   "t": 242.5,
   "text": "깨지고 뉘우치는 마음을"
  },
  {
   "t": 243.3,
   "text": "주는 멸시하지 않으시리"
  },
  {
   "t": 244,
   "text": "하나님이여 내 안에 정한 마음 지으시고"
  },
  {
   "t": 244.8,
   "text": "정직한 영을 내 속에 새롭게 하소서"
  },
  {
   "t": 245.5,
   "text": "주여 내 입술을 열어 주소서"
  },
  {
   "t": 246.3,
   "text": "내 입이 주를 찬송하리이다"
  },
  {
   "t": 247,
   "text": "내 안에 정한 마음 지으소서"
  }
 ]
}
