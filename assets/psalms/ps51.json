{
 "src": "https://pub-7d2b46014d5b4769a48e210890df23c4.r2.dev/psalms/ps51-7dad7db270.mp3",
 "audio": "7dad7db2701364cd3a715a4689ba8c98ea68dc56ff5bb16f94f02ec47eb9f783",
 "by": "auto",
 "lines": [
  {
   "t": 14,
   "text": "하나님이여 주의 인자를 따라"
  },
  {
   "t": 20.5,
   "text": "나를 불쌍히 여기소서"
  },
  {
   "t": 27,
   "text": "주의 크신 긍휼을 따라"
  },
  {
   "t": 33.5,
   "text": "내 죄악을 지워 주소서"
  },
  {
   "t": 42.5,
   "text": "나는 내 허물을 아오니"
  },
  {
   "t": 49,
   "text": "내 죄가 늘 내 앞에 있나이다"
  },
  {
   "t": 56,
   "text": "내가 주께만 죄를 지어"
  },
  {
   "t": 62.5,
   "text": "주 앞에 악을 행하였나이다"
  },
  {
   "t": 73.5,
   "text": "하나님이여 내 안에 정한 마음 지으시고"
  },
  {
   "t": 80,
   "text": "정직한 영을 내 속에 새롭게 하소서"
  },
  {
   "t": 87,
   "text": "주 앞에서 나를 내치지 마시며"
  },
  {
   "t": 93.5,
   "text": "주의 성령을 거두지 마소서"
  },
  {
   "t": 118.5,
   "text": "우슬초로 나를 정결하게 하소서"
  },
  {
   "t": 125,
   "text": "내가 깨끗하리이다"
  },
  {
   "t": 131.5,
   "text": "나를 씻어 주소서"
  },
  {
   "t": 138,
   "text": "내가 눈보다 희리이다"
  },
  {
   "t": 147,
   "text": "주의 구원의 기쁨을 다시 주시고"
  },
  {
   "t": 153.5,
   "text": "기꺼운 영으로 나를 붙드소서"
  },
  {
   "t": 160.5,
   "text": "주께서 원하시는 제사는 상한 마음이라"
  },
  {
   "t": 167,
   "text": "깨지고 뉘우치는 마음을"
  },
  {
   "t": 173.5,
   "text": "주는 멸시하지 않으시리"
  },
  {
   "t": 180.5,
   "text": "하나님이여 내 안에 정한 마음 지으시고"
  },
  {
   "t": 187,
   "text": "정직한 영을 내 속에 새롭게 하소서"
  },
  {
   "t": 194,
   "text": "주여 내 입술을 열어 주소서"
  },
  {
   "t": 200.5,
   "text": "내 입이 주를 찬송하리이다"
  },
  {
   "t": 211.5,
   "text": "내 안에 정한 마음 지으소서"
  }
 ]
}
