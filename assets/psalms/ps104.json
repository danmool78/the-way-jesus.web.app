{
 "src": "https://pub-7d2b46014d5b4769a48e210890df23c4.r2.dev/psalms/ps104-aca5409cca.mp3",
 "audio": "aca5409ccadcc3adcce4ee81fafaf53593d14e9e59245c91c1f57267fdb15d71",
 "by": "auto",
 "lines": [
  {
   "t": 14,
   "text": "내 영혼아 여호와를 송축하라"
  },
  {
   "t": 20.5,
   "text": "빛을 옷처럼 두르시고"
  },
  {
   "t": 25.5,
   "text": "하늘을 장막처럼 펼치시며"
  },
  {
   "t": 31.5,
   "text": "바람 날개로 거니시네"
  },
  {
   "t": 39.5,
   "text": "땅의 기초를 굳건히 놓으사"
  },
  {
   "t": 46,
   "text": "영원히 흔들림 없게 하셨네"
  },
  {
   "t": 53,
   "text": "물에게 경계를 정하시고"
  },
  {
   "t": 58.5,
   "text": "그 선을 넘지 못하게 막으셨네"
  },
  {
   "t": 69,
   "text": "골짜기마다 샘물 흐르게 하시니"
  },
  {
   "t": 75.5,
   "text": "들나귀 갈증 해소하고"
  },
  {
   "t": 81.5,
   "text": "새들은 나뭇가지 사이에서 노래하네"
  },
  {
   "t": 88,
   "text": "사람 마음 즐겁게 하는 포도주도 주셨네"
  },
  {
   "t": 95.5,
   "text": "여호와여 주께서 하신 일들이"
  },
  {
   "t": 102,
   "text": "어찌 이리도 놀라운지요"
  },
  {
   "t": 108.5,
   "text": "지혜로 이 모든 것을 창조하시니"
  },
  {
   "t": 115,
   "text": "온 땅에 주의 작품 가득하네"
  },
  {
   "t": 124.5,
   "text": "모두가 주만 바라보며"
  },
  {
   "t": 128.5,
   "text": "때를 따라 양식을 얻네"
  },
  {
   "t": 131.5,
   "text": "주께서 얼굴 가리시면 두려워 떨고"
  },
  {
   "t": 138,
   "text": "주의 영 보내시면 새 생명 얻어"
  },
  {
   "t": 144.5,
   "text": "온 땅이 다시 살아나네"
  },
  {
   "t": 151,
   "text": "여호와여 주께서 하신 일들이"
  },
  {
   "t": 157.5,
   "text": "어찌 이리도 놀라운지요"
  },
  {
   "t": 164,
   "text": "내 삶이 다하는 날까지 여호와께 노래하리"
  },
  {
   "t": 170.5,
   "text": "내 모든 순간 하나님을 찬양하리"
  },
  {
   "t": 181,
   "text": "내 영혼아 여호와를 송축하라"
  },
  {
   "t": 188,
   "text": "할렐루야"
  }
 ]
}
