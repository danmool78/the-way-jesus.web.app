 "by": "auto",
 "lines": [
  {
   "t": 20.5,
   "text": "나를 불쌍히 여기소서 하나님이여"
  },
  {
   "t": 26.8,
   "text": "내 영혼이 주께로 피하나이다"
  },
  {
   "t": 33.2,
   "text": "이 재앙들이 다 지나가기까지"
  },
  {
   "t": 39.6,
   "text": "주의 날개 그늘 아래 숨으리이다"
  },
  {
   "t": 48.5,
   "text": "내 영혼이 사자들 가운데 있어"
  },
  {
   "t": 54.9,
   "text": "불 사르는 자들 틈에 누웠나이다"
  },
  {
   "t": 61.3,
   "text": "그들의 이는 창과 화살이요"
  },
  {
   "t": 67.7,
   "text": "그 혀는 날카로운 칼이니이다"
  },
  {
   "t": 76.5,
   "text": "하나님이여 하늘 위에 높이 들리소서"
  },
  {
   "t": 82.9,
   "text": "주의 영광이 온 땅 위에 높아지소서"
  },
  {
   "t": 91.7,
   "text": "그들이 내 걸음 앞에 그물을 치고"
  },
  {
   "t": 98.1,
   "text": "웅덩이를 팠으나 스스로 빠졌나이다"
  },
  {
   "t": 106.1,
   "text": "내 마음이 정하여졌나이다"
  },
  {
   "t": 112.5,
   "text": "내가 노래하며 찬송하리이다"
  },
  {
   "t": 118.9,
   "text": "내 영광아 깰지어다"
  },
  {
   "t": 121.3,
   "text": "비파야 수금아 깰지어다"
  },
  {
   "t": 124.5,
   "text": "내가 새벽을 깨우리로다"
  },
  {
   "t": 132.5,
   "text": "주의 인자는 커서 하늘에 닿고"
  },
  {
   "t": 138.9,
   "text": "주의 진리는 구름에 이르나이다"
  },
  {
   "t": 147.7,
   "text": "하나님이여 하늘 위에 높이 들리소서"
  },
  {
   "t": 154.1,
   "text": "주의 영광이 온 땅 위에 높아지소서"
  },
  {
   "t": 167.7,
   "text": "내가 새벽을 깨우리로다"
  }
 ]
}
