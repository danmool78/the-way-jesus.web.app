{
 "src": "https://pub-7d2b46014d5b4769a48e210890df23c4.r2.dev/psalms/ps30-396421fb1a.mp3",
 "audio": "396421fb1a4d343700e3fd6bd8ae62d6c5453738d6d4992b1642bd388c3005a6",
 "by": "tap",
 "lines": [
  {
   "t": 15.73,
   "text": "여호와여 내가 주를 높이리니"
  },
  {
   "t": 23.41,
   "text": "깊은 데서 나를 끌어올리셨네"
  },
  {
   "t": 30.58,
   "text": "원수가 나를 보고 웃지 못하게"
  },
  {
   "t": 37.9,
   "text": "주께 부르짖으니 고치셨네"
  },
  {
   "t": 45.23,
   "text": "내 영혼을 스올에서 끌어내시고"
  },
  {
   "t": 52.54,
   "text": "무덤에 내려가지 않게 살리셨네"
  },
  {
   "t": 59.96,
   "text": "그의 노염은 잠깐이요"
  },
  {
   "t": 66.84,
   "text": "그의 은총은 평생이라"
  },
  {
   "t": 74.05,
   "text": "저녁에는 울음이 머물러도"
  },
  {
   "t": 81.88,
   "text": "아침에는 기쁨이 오리라"
  },
  {
   "t": 92.85,
   "text": "내가 평안할 때 말하기를"
  },
  {
   "t": 99.71,
   "text": "영원히 흔들리지 않으리라 했네"
  },
  {
   "t": 106.73,
   "text": "주께서 얼굴을 가리시니"
  },
  {
   "t": 114.74,
   "text": "내가 근심하였네"
  },
  {
   "t": 121.42,
   "text": "내 피가 무슨 유익이 있으리오"
  },
  {
   "t": 128.52,
   "text": "티끌이 어찌 주를 찬송하리오"
  },
  {
   "t": 135.56,
   "text": "여호와여 들으사 나를 긍휼히 여기소서"
  },
  {
   "t": 143.08,
   "text": "나를 돕는 이가 되어 주소서"
  },
  {
   "t": 150.36,
   "text": "주께서 나의 슬픔을 춤으로 바꾸시고"
  },
  {
   "t": 157.63,
   "text": "베옷을 벗기고 기쁨으로 띠 띠우셨네"
  },
  {
   "t": 164.63,
   "text": "잠잠하지 않고 주를 찬송하리니"
  },
  {
   "t": 172.16,
   "text": "영원히 주께 감사하리라"
  },
  {
   "t": 181.88,
   "text": "저녁에는 울음이 머물러도"
  },
  {
   "t": 190.4,
   "text": "아침에는 기쁨이 오리라"
  }
 ]
}
