 "lines": [
  {
   "t": 18.5,
   "text": "여호와 우리 주여"
  },
  {
   "t": 24.5,
   "text": "주의 이름 온 땅에"
  },
  {
   "t": 31.5,
   "text": "어찌 그리 아름다운지"
  },
  {
   "t": 41.5,
   "text": "주의 영광 하늘에 두셨네"
  },
  {
   "t": 48.5,
   "text": "어린 아이와 젖먹이의 입으로"
  },
  {
   "t": 55.5,
   "text": "주께서 능력을 세우시니"
  },
  {
   "t": 62.5,
   "text": "원수와 보복하려는 자들을"
  },
  {
   "t": 72.5,
   "text": "잠잠하게 하려 하심이라"
  },
  {
   "t": 79.5,
   "text": "주의 손가락으로 만드신 저 하늘"
  },
  {
   "t": 86.5,
   "text": "주께서 펼쳐 놓으신 달과 별들"
  },
  {
   "t": 92.5,
   "text": "제가 그 하늘을 올려다볼 때"
  },
  {
   "t": 108.5,
   "text": "사람이 무엇이기에 주께서 기억하시며"
  },
  {
   "t": 116.5,
   "text": "인생이 무엇이기에 보살피시나요"
  },
  {
   "t": 124.5,
   "text": "하나님보다 조금 못하게 만드시고"
  },
  {
   "t": 132.5,
   "text": "영광과 존귀로 왕관 씌우셨네"
  },
  {
   "t": 139.5,
   "text": "모든 양과 소떼"
  },
  {
   "t": 143.5,
   "text": "들판의 짐승들"
  },
  {
   "t": 146.5,
   "text": "하늘의 새들과 바다의 물고기들까지"
  },
  {
   "t": 152.5,
   "text": "주의 손이 만드신 모든 것을 맡기셨네"
  },
  {
   "t": 170.5,
   "text": "여호와 우리 주여"
  },
  {
   "t": 177.5,
   "text": "주의 이름 온 땅에"
  },
  {
   "t": 184.5,
   "text": "어찌 그리 아름다운지"
  },
  {
   "t": 192.5,
   "text": "어찌 그리 아름다운지"
  },
  {
   "t": 200.5,
   "text": "온 땅에 가득한 주의 아름다운 이름"
  }
 ]
