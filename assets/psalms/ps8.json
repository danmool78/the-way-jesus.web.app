 "lines": [
  {
   "t": 16.86,
   "text": "여호와 우리 주여"
  },
  {
   "t": 25.51,
   "text": "주의 이름 온 땅에"
  },
  {
   "t": 33.21,
   "text": "어찌 그리 아름다운지"
  },
  {
   "t": 40.55,
   "text": "주의 영광 하늘에 두셨네"
  },
  {
   "t": 47.97,
   "text": "어린 아이와 젖먹이의 입으로"
  },
  {
   "t": 55.37,
   "text": "주께서 능력을 세우시니"
  },
  {
   "t": 62.74,
   "text": "원수와 보복하려는 자들을"
  },
  {
   "t": 70.31,
   "text": "잠잠하게 하려 하심이라"
  },
  {
   "t": 77.74,
   "text": "주의 손가락으로 만드신 저 하늘"
  },
  {
   "t": 85.12,
   "text": "주께서 펼쳐 놓으신 달과 별들"
  },
  {
   "t": 92.78,
   "text": "제가 그 하늘을 올려다볼 때"
  },
  {
   "t": 106.69,
   "text": "사람이 무엇이기에 주께서 기억하시며"
  },
  {
   "t": 114.46,
   "text": "인생이 무엇이기에 보살피시나요"
  },
  {
   "t": 121.83,
   "text": "하나님보다 조금 못하게 만드시고"
  },
  {
   "t": 129.43,
   "text": "영광과 존귀로 왕관 씌우셨네"
  },
  {
   "t": 137.11,
   "text": "모든 양과 소떼"
  },
  {
   "t": 140.64,
   "text": "들판의 짐승들"
  },
  {
   "t": 144.66,
   "text": "하늘의 새들과 바다의 물고기들까지"
  },
  {
   "t": 151.75,
   "text": "주의 손이 만드신 모든 것을 맡기셨네"
  },
  {
   "t": 170.26,
   "text": "여호와 우리 주여"
  },
  {
   "t": 177.09,
   "text": "주의 이름 온 땅에"
  },
  {
   "t": 185.02,
   "text": "어찌 그리 아름다운지"
  },
  {
   "t": 192.12,
   "text": "어찌 그리 아름다운지"
  },
  {
   "t": 200.1,
   "text": "온 땅에 가득한 주의 아름다운 이름"
  }
 ]
