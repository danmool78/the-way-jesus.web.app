 "by": "auto",
 "lines": [
  {
   "t": 18.5,
   "text": "하나님이여 주는 나의 하나님"
  },
  {
   "t": 25,
   "text": "내가 간절히 주를 찾나이다"
  },
  {
   "t": 32.5,
   "text": "물 없는 메마른 땅에서"
  },
  {
   "t": 39.5,
   "text": "내 영혼이 주를 목말라하며"
  },
  {
   "t": 44,
   "text": "내 몸이 주를 그리워하나이다"
  },
  {
   "t": 51.5,
   "text": "주의 권능과 영광을 보려고"
  },
  {
   "t": 58.5,
   "text": "성소에서 주를 바라보았나이다"
  },
  {
   "t": 109.5,
   "text": "주의 인자하심이 생명보다 나으니"
  },
  {
   "t": 120,
   "text": "내 입술이 주를 찬양하리라"
  },
  {
   "t": 126.5,
   "text": "내 평생에 주를 송축하며"
  },
  {
   "t": 133.5,
   "text": "주의 이름으로 내 손을 들리라"
  },
  {
   "t": 211.5,
   "text": "기름진 것을 먹은 듯이"
  },
  {
   "t": 218.5,
   "text": "내 영혼이 흡족하리니"
  },
  {
   "t": 225.5,
   "text": "내 입이 기쁜 입술로"
  },
  {
   "t": 225.9,
   "text": "주를 찬송하리이다"
  },
  {
   "t": 226.3,
   "text": "내 침상에서 주를 기억하며"
  },
  {
   "t": 226.6,
   "text": "밤의 경점마다 주를 묵상하리니"
  },
  {
   "t": 227,
   "text": "주는 나의 도움이 되셨으므로"
  },
  {
   "t": 227.4,
   "text": "주의 날개 그늘에서 즐거이 노래하리"
  },
  {
   "t": 227.8,
   "text": "내 영혼이 주를 가까이 따르니"
  },
  {
   "t": 228.2,
   "text": "주의 오른손이 나를 붙드시네"
  },
  {
   "t": 228.6,
   "text": "주의 인자하심이 생명보다 나으니"
  },
  {
   "t": 228.9,
   "text": "내 입술이 주를 찬양하리라"
  },
  {
   "t": 229.3,
   "text": "왕은 하나님을 즐거워하리라"
  }
 ],
 "seek": true
}
