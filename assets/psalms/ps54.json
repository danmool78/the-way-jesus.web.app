 "lines": [
  {
   "t": 13.5,
   "text": "하나님이여 주의 이름으로 나를 구하시고"
  },
  {
   "t": 18.8,
   "text": "주의 힘으로 나를 변호하소서"
  },
  {
   "t": 24.5,
   "text": "하나님이여 내 기도를 들으시며"
  },
  {
   "t": 31.5,
   "text": "내 입의 말에 귀를 기울이소서"
  },
  {
   "t": 38.5,
   "text": "낯선 자들이 일어나 나를 치고"
  },
  {
   "t": 44.5,
   "text": "포악한 자들이 내 생명을 찾나이다"
  },
  {
   "t": 50.5,
   "text": "그들은 하나님을 앞에 두지 않았나이다"
  },
  {
   "t": 103.5,
   "text": "보라 하나님은 나를 돕는 이시라"
  },
  {
   "t": 109.5,
   "text": "주는 내 생명을 붙드시는 분"
  },
  {
   "t": 115.5,
   "text": "보라 하나님은 나를 돕는 이시라"
  },
  {
   "t": 121.5,
   "text": "주께서 나를 붙드시네"
  },
  {
   "t": 131.5,
   "text": "내가 즐거이 주께 제물을 드리리니"
  },
  {
   "t": 138.5,
   "text": "여호와여 주의 이름에 감사하리라"
  },
  {
   "t": 144.5,
   "text": "주의 이름이 선하심이라"
  },
  {
   "t": 156.5,
   "text": "보라 하나님은 나를 돕는 이시라"
  },
  {
   "t": 159.1,
   "text": "주는 내 생명을 붙드시는 분"
  },
  {
   "t": 161.7,
   "text": "모든 환난에서 나를 건지셨으니"
  },
  {
   "t": 164.3,
   "text": "내 눈이 원수를 내려다보게 되었네"
  },
  {
   "t": 166.9,
   "text": "주의 이름이 선하심이라"
  }
 ]
