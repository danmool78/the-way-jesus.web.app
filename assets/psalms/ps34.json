 "by": "auto",
 "lines": [
  {
   "t": 21.5,
   "text": "내가 여호와를 늘 송축하리니"
  },
  {
   "t": 25.5,
   "text": "그를 찬양함이 내 입에 끊이지 않으리"
  },
  {
   "t": 31.5,
   "text": "내 영혼이 여호와를 자랑하리니"
  },
  {
   "t": 35.5,
   "text": "곤고한 자들이 듣고 기뻐하리"
  },
  {
   "t": 41.5,
   "text": "나와 함께 여호와를 크다 하며"
  },
  {
   "t": 45.5,
   "text": "다 같이 그 이름을 높이세"
  },
  {
   "t": 49.5,
   "text": "너희는 여호와의 선하심을"
  },
  {
   "t": 53.5,
   "text": "맛보아 알지어다"
  },
  {
   "t": 57.5,
   "text": "그에게 피하는 사람은"
  },
  {
   "t": 61.5,
   "text": "복이 있도다"
  },
  {
   "t": 65.5,
   "text": "내가 여호와께 구하매 응답하시고"
  },
  {
   "t": 69.5,
   "text": "모든 두려움에서 나를 건지셨네"
  },
  {
   "t": 73.5,
   "text": "이 가난한 자가 부르짖었더니"
  },
  {
   "t": 77.5,
   "text": "모든 환난에서 구원하셨네"
  },
  {
   "t": 81.5,
   "text": "여호와의 천사가"
  },
  {
   "t": 85.5,
   "text": "주를 두려워하는 자를 둘러 진 치고"
  },
  {
   "t": 89.5,
   "text": "그들을 건지시는도다"
  },
  {
   "t": 93.5,
   "text": "마음이 상한 자를 가까이하시고"
  },
  {
   "t": 97.5,
   "text": "충심으로 뉘우치는 자를 구하시네"
  },
  {
   "t": 109.5,
   "text": "너희는 여호와의 선하심을"
  },
  {
   "t": 113.5,
   "text": "맛보아 알지어다"
  },
  {
   "t": 117.5,
   "text": "의인은 고난이 많으나"
  },
  {
   "t": 121.5,
   "text": "여호와께서 모두 건지시도다"
  },
  {
   "t": 125.5,
   "text": "그에게 피하는 사람은 복이 있도다"
  }
 ],
