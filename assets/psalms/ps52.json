{
 "src": "https://pub-7d2b46014d5b4769a48e210890df23c4.r2.dev/psalms/ps52-402bec2164.mp3",
 "audio": "402bec2164360e7e51e5841e302871a2e796ded1a12316064d34dd5a5197a5e0",
 "by": "auto",
 "lines": [
  {
   "t": 14.5,
   "text": "포악한 자여 어찌하여"
  },
  {
   "t": 18.5,
   "text": "악한 꾀를 자랑하는가"
  },
  {
   "t": 24.5,
   "text": "하나님의 인자하심은"
  },
  {
   "t": 29.5,
   "text": "언제나 한결같네"
  },
  {
   "t": 35.5,
   "text": "네 혀는 날카로운 칼날 같아"
  },
  {
   "t": 40.5,
   "text": "거짓을 말하고 악을 꾀하네"
  },
  {
   "t": 44.5,
   "text": "선보다 악을 더 사랑하고"
  },
  {
   "t": 49.5,
   "text": "진실보다 거짓을 즐겨 말하네"
  },
  {
   "t": 54.5,
   "text": "하나님이 너를 영원히 멸하시리라"
  },
  {
   "t": 59.5,
   "text": "네 거처에서 너를 뽑아내시리라"
  },
  {
   "t": 65.5,
   "text": "그러나 나는 하나님의 집에 심긴"
  },
  {
   "t": 71.5,
   "text": "푸른 올리브 나무 같으니"
  },
  {
   "t": 76.5,
   "text": "하나님의 사랑과 자비를"
  },
  {
   "t": 81.5,
   "text": "영원히 의지하리라"
  },
  {
   "t": 98.5,
   "text": "의인이 보고 두려워하며 말하리라"
  },
  {
   "t": 103.5,
   "text": "이 사람을 보라"
  },
  {
   "t": 108.5,
   "text": "하나님을 의지하지 않고"
  },
  {
   "t": 113.5,
   "text": "자신의 재물을 믿던 자를"
  },
  {
   "t": 118.5,
   "text": "그러나 나는 하나님의 집에 심긴"
  },
  {
   "t": 123.5,
   "text": "푸른 올리브 나무 같으니"
  },
  {
   "t": 128.5,
   "text": "주께서 이 일을 이루셨으니"
  },
  {
   "t": 133.5,
   "text": "영원히 주께 감사하리라"
  },
  {
   "t": 138.5,
   "text": "주의 이름은 선하시니"
  },
  {
   "t": 143.5,
   "text": "주의 성도들 앞에서 주를 기다리리라"
  }
 ]
}
