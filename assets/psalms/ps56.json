 "lines": [
  {
   "t": 16.5,
   "text": "하나님이여 나를 불쌍히 여기소서"
  },
  {
   "t": 22.5,
   "text": "사람이 나를 삼키려 하나이다"
  },
  {
   "t": 27.5,
   "text": "종일 싸우며 나를 짓누르고"
  },
  {
   "t": 32.5,
   "text": "나를 치는 자가 많사오니"
  },
  {
   "t": 43.5,
   "text": "내가 두려워하는 날에는"
  },
  {
   "t": 48.5,
   "text": "주를 의지하리이다"
  },
  {
   "t": 54.5,
   "text": "하나님을 의지하였으니"
  },
  {
   "t": 60.5,
   "text": "사람이 내게 어찌하리이까"
  },
  {
   "t": 73.5,
   "text": "그들이 날마다 내 말을 뒤틀고"
  },
  {
   "t": 78.5,
   "text": "나를 해하려 생각하나이다"
  },
  {
   "t": 84.5,
   "text": "모여 숨어서 내 발자취를 살피며"
  },
  {
   "t": 90.5,
   "text": "내 목숨을 엿보나이다"
  },
  {
   "t": 101.5,
   "text": "나의 떠돌아다님을 주께서 세셨으니"
  },
  {
   "t": 107.5,
   "text": "내 눈물을 주의 병에 담으소서"
  },
  {
   "t": 113.5,
   "text": "이것이 주의 책에"
  },
  {
   "t": 116.5,
   "text": "적혀 있지 아니하니이까"
  },
  {
   "t": 129.5,
   "text": "내가 두려워하는 날에는"
  },
  {
   "t": 134.5,
   "text": "주를 의지하리이다"
  },
  {
   "t": 140.5,
   "text": "하나님을 의지하였으니"
  },
  {
   "t": 146.5,
   "text": "사람이 내게 어찌하리이까"
  },
  {
   "t": 153.5,
   "text": "주께서 내 생명을 사망에서 건지셨으니"
  },
  {
   "t": 163.5,
   "text": "생명의 빛 가운데 주 앞에서 다니리라"
  }
