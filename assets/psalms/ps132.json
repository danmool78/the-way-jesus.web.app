 "lines": [
  {
   "t": 17.5,
   "text": "여호와여 다윗을 기억하소서"
  },
  {
   "t": 24,
   "text": "그가 겪은 모든 고난을"
  },
  {
   "t": 31.5,
   "text": "그가 여호와께 맹세하고"
  },
  {
   "t": 37.5,
   "text": "야곱의 전능자께 서원하였네"
  },
  {
   "t": 45.5,
   "text": "내 집 장막에 들어가지 않고"
  },
  {
   "t": 52,
   "text": "내 침상에도 오르지 않으리라"
  },
  {
   "t": 59.5,
   "text": "여호와의 처소를 찾기까지"
  },
  {
   "t": 66.5,
   "text": "내 눈에 잠을 들이지 않으리라"
  },
  {
   "t": 73.5,
   "text": "에브라다에서 그 소식을 듣고"
  },
  {
   "t": 80,
   "text": "나무 밭에서 그것을 찾았도다"
  },
  {
   "t": 87,
   "text": "우리가 그의 처소로 들어가"
  },
  {
   "t": 94,
   "text": "그 발등상 앞에 엎드리리라"
  },
  {
   "t": 101,
   "text": "여호와여 일어나 쉬실 곳으로 드소서"
  },
  {
   "t": 108,
   "text": "주의 권능의 궤와 함께 드소서"
  },
  {
   "t": 115,
   "text": "주의 제사장들은 의를 입고"
  },
  {
   "t": 122,
   "text": "주의 성도들은 기뻐 외칠지어다"
  },
  {
   "t": 129,
   "text": "여호와께서 시온을 택하시고"
  },
  {
   "t": 136,
   "text": "거기를 거처로 삼으셨네"
  },
  {
   "t": 143,
   "text": "이는 내가 영원히 쉴 곳이라"
  },
  {
   "t": 150,
   "text": "내가 여기 머물리라 하셨네"
  },
  {
   "t": 157,
   "text": "여호와여 일어나 쉬실 곳으로 드소서"
  },
  {
   "t": 164,
   "text": "주의 권능의 궤와 함께 드소서"
  },
  {
   "t": 171,
   "text": "거기서 다윗에게 뿔이 나게 하시고"
  },
  {
   "t": 178,
   "text": "기름 부은 자를 위해 등불을 켜시리라"
  },
  {
   "t": 185,
   "text": "이는 내가 영원히 쉴 곳이라"
  }
