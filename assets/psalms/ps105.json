{
 "src": "https://pub-7d2b46014d5b4769a48e210890df23c4.r2.dev/psalms/ps105-1e01b383ce.mp3",
 "audio": "1e01b383ce31d3eaf55ae96fffa333311f4482f785306ea445f4c363086c4d49",
 "by": "auto",
 "lines": [
  {
   "t": 16.5,
   "text": "여호와께 감사하며 그 이름을 부르라"
  },
  {
   "t": 22.5,
   "text": "그가 하신 일을 만민에게 알리라"
  },
  {
   "t": 31.5,
   "text": "그의 기이한 일들을 기억하라"
  },
  {
   "t": 38.5,
   "text": "그 입의 판단을 잊지 말아라"
  },
  {
   "t": 44.5,
   "text": "그는 그 언약을 영원히 기억하시네"
  },
  {
   "t": 52.5,
   "text": "천 대에 명하신 그 말씀을"
  },
  {
   "t": 59.5,
   "text": "아브라함과 맺으신 언약"
  },
  {
   "t": 65.5,
   "text": "이삭에게 하신 그 맹세"
  },
  {
   "t": 112.5,
   "text": "사람 수 적어 나그네 되었을 때"
  },
  {
   "t": 119.5,
   "text": "이 나라 저 나라로 떠돌았으나"
  },
  {
   "t": 126.5,
   "text": "아무도 그들을 해치지 못하게"
  },
  {
   "t": 133.5,
   "text": "왕들을 꾸짖어 지키셨네"
  },
  {
   "t": 140.5,
   "text": "한 사람을 앞서 보내셨으니"
  },
  {
   "t": 147.5,
   "text": "종으로 팔려 간 요셉이라"
  },
  {
   "t": 154.5,
   "text": "그 말씀이 이루어질 때까지"
  },
  {
   "t": 161.5,
   "text": "여호와의 말씀이 그를 단련했네"
  },
  {
   "t": 208.5,
   "text": "모세와 아론을 보내시고"
  },
  {
   "t": 215.5,
   "text": "어둠을 보내 땅을 캄캄하게 하셨네"
  },
  {
   "t": 216,
   "text": "구름을 펴서 덮어 주시고"
  },
  {
   "t": 216.5,
   "text": "밤에는 불로 밝혀 주셨네"
  },
  {
   "t": 217,
   "text": "하늘 양식으로 배부르게 하시고"
  },
  {
   "t": 217.5,
   "text": "반석을 여시니 물이 강같이 흘렀네"
  },
  {
   "t": 218,
   "text": "그는 그 언약을 영원히 기억하시네"
  },
  {
   "t": 218.5,
   "text": "그 백성을 기쁨으로 이끄시고"
  },
  {
   "t": 219,
   "text": "택하신 자를 노래하며 나오게 하셨네"
  },
  {
   "t": 219.5,
   "text": "할렐루야"
  }
 ]
}
