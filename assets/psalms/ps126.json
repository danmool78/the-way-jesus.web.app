 "lines": [
  {
   "t": 10.5,
   "text": "여호와께서 시온의 포로를"
  },
  {
   "t": 13.5,
   "text": "돌려보내실 때에"
  },
  {
   "t": 16.5,
   "text": "우리는 꿈꾸는 것 같았네"
  },
  {
   "t": 20,
   "text": "입에는 웃음이 가득하고"
  },
  {
   "t": 23.5,
   "text": "혀에는 찬양이 넘쳤네"
  },
  {
   "t": 28.5,
   "text": "여호와께서 그들에게 큰일을 하셨다"
  },
  {
   "t": 34.5,
   "text": "뭇 나라 사람들이 말하였네"
  },
  {
   "t": 39,
   "text": "여호와께서 우리에게 큰일을 하셨으니"
  },
  {
   "t": 44.5,
   "text": "우리는 기뻐하네"
  },
  {
   "t": 49,
   "text": "여호와여 우리 포로를 돌리소서"
  },
  {
   "t": 54,
   "text": "남방의 시내들처럼"
  },
  {
   "t": 58.5,
   "text": "눈물로 씨를 뿌리는 이는"
  },
  {
   "t": 63.5,
   "text": "기쁨으로 거두리라"
  },
  {
   "t": 68.5,
   "text": "울며 씨를 메고 나간 이는"
  },
  {
   "t": 73.5,
   "text": "기쁨으로 단을 안고 돌아오리라"
  },
  {
   "t": 78.5,
   "text": "눈물로 씨를 뿌리는 이는"
  },
  {
   "t": 83.5,
   "text": "기쁨으로 거두리라"
  }
