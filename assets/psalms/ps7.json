 "lines": [
  {
   "t": 15.23,
   "text": "여호와 나의 하나님"
  },
  {
   "t": 22.84,
   "text": "내가 주께 피하오니"
  },
  {
   "t": 30.01,
   "text": "나를 쫓는 모든 자에게서"
  },
  {
   "t": 37.8,
   "text": "나를 구하여 건지소서"
  },
  {
   "t": 45.08,
   "text": "사자같이 나를 찢을까"
  },
  {
   "t": 52,
   "text": "건질 자 없을까 두렵습니다"
  },
  {
   "t": 59.64,
   "text": "여호와여 내가 이 일을 했다면"
  },
  {
   "t": 66.77,
   "text": "내 손에 죄악이 있다면"
  },
  {
   "t": 74.06,
   "text": "화목한 자를 악으로 갚았다면"
  },
  {
   "t": 81.58,
   "text": "원수가 나를 쫓아 짓밟게 하소서"
  },
  {
   "t": 89,
   "text": "여호와여 일어나소서"
  },
  {
   "t": 97.27,
   "text": "나를 위하여 깨어나소서"
  },
  {
   "t": 104.91,
   "text": "의로우신 재판장 하나님"
  },
  {
   "t": 111.9,
   "text": "마음과 속을 살피시는 분"
  },
  {
   "t": 119.06,
   "text": "악인의 악을 끊으시고"
  },
  {
   "t": 126.57,
   "text": "의인을 굳게 세우소서"
  },
  {
   "t": 134.55,
   "text": "나의 방패는 하나님께 있으니"
  },
  {
   "t": 141.1,
   "text": "마음이 바른 자를 구원하시네"
  },
  {
   "t": 148.3,
   "text": "남을 빠뜨리려 판 구덩이에"
  },
  {
   "t": 155.61,
   "text": "그가 스스로 빠지리라"
  },
  {
   "t": 163.43,
   "text": "여호와여 일어나소서"
  },
  {
   "t": 171.27,
   "text": "의로우신 재판장 하나님"
  },
  {
   "t": 178.59,
   "text": "내가 주의 의를 따라 감사하리"
  },
  {
   "t": 185.54,
   "text": "지존하신 여호와의 이름을 찬양하리"
  },
  {
   "t": 197.7,
   "text": "여호와의 이름을 찬양하리"
  }
