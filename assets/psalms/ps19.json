 "by": "auto",
 "lines": [
  {
   "t": 11.5,
   "text": "하늘이 하나님의 영광을 말하고"
  },
  {
   "t": 16.5,
   "text": "궁창이 그 손으로 하신 일을 알리네"
  },
  {
   "t": 22.5,
   "text": "낮은 낮에게 그 소식을 건네고"
  },
  {
   "t": 28.5,
   "text": "밤은 밤에게 그 지혜를 전하네"
  },
  {
   "t": 34.5,
   "text": "소리도 없고 말도 없지만"
  },
  {
   "t": 40.5,
   "text": "그 울림 온 땅에 번져 가네"
  },
  {
   "t": 46.5,
   "text": "해는 신방에서 나온 신랑처럼"
  },
  {
   "t": 51.5,
   "text": "길을 달리는 용사처럼 기쁘네"
  },
  {
   "t": 57.5,
   "text": "하늘 끝에서 저 끝까지"
  },
  {
   "t": 63.5,
   "text": "그 빛을 피할 자 없네"
  },
  {
   "t": 69.5,
   "text": "여호와의 율법은 완전하여"
  },
  {
   "t": 75.5,
   "text": "내 영혼을 다시 살리고"
  },
  {
   "t": 81.5,
   "text": "여호와의 증거는 분명하여"
  },
  {
   "t": 87.5,
   "text": "어리석은 자를 지혜롭게 하네"
  },
  {
   "t": 103.5,
   "text": "금보다 순금보다 더 귀한 말씀"
  },
  {
   "t": 109.5,
   "text": "꿀보다 송이꿀보다 더 단 말씀"
  },
  {
   "t": 115.5,
   "text": "숨은 허물을 씻어 내시고"
  },
  {
   "t": 121.5,
   "text": "고집 센 죄에서 날 지켜 주소서"
  },
  {
   "t": 129.5,
   "text": "여호와의 율법은 완전하여"
  },
  {
   "t": 135.5,
   "text": "내 영혼을 다시 살리네"
  },
  {
   "t": 141.5,
   "text": "나의 반석 나의 구속자 여호와여"
  },
  {
   "t": 147.5,
   "text": "내 입의 말과 마음의 묵상이"
  },
  {
   "t": 153.5,
   "text": "주 앞에 기쁘게 받아지기를"
  },
  {
   "t": 161.5,
   "text": "나의 반석 나의 구속자"
  }
 ],
 "seek": true
}
