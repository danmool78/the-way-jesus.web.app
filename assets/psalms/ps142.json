{
 "src": "https://pub-7d2b46014d5b4769a48e210890df23c4.r2.dev/psalms/ps142-d510ec0706.mp3",
 "audio": "d510ec0706299ec3ae93a91f2f820f008403766d02ffd573d776f695b6c019d7",
 "by": "auto",
 "lines": [
  {
   "t": 15.2,
   "text": "내가 소리 내어 여호와께 부르짖네"
  },
  {
   "t": 22.5,
   "text": "소리 내어 여호와께 간구하네"
  },
  {
   "t": 29.5,
   "text": "내 원통함을 주 앞에 쏟아 놓고"
  },
  {
   "t": 36.5,
   "text": "내 우환을 그 앞에 아뢰네"
  },
  {
   "t": 43.5,
   "text": "내 영이 속에서 꺼져 갈 때에도"
  },
  {
   "t": 51,
   "text": "주께서 내 길을 아셨나이다"
  },
  {
   "t": 58,
   "text": "내 오른편을 살펴보소서"
  },
  {
   "t": 65,
   "text": "나를 아는 이가 아무도 없고"
  },
  {
   "t": 72,
   "text": "내가 피할 곳도 없으며"
  },
  {
   "t": 76.5,
   "text": "내 영혼을 돌보는 이도 없나이다"
  },
  {
   "t": 85.5,
   "text": "여호와여 내가 주께 부르짖어"
  },
  {
   "t": 92.5,
   "text": "주는 나의 피난처라 말하네"
  },
  {
   "t": 99.5,
   "text": "산 자들의 땅에서"
  },
  {
   "t": 103.5,
   "text": "주는 나의 몫이시라"
  },
  {
   "t": 116.5,
   "text": "나를 따르는 자들에게서 건지소서"
  },
  {
   "t": 123.5,
   "text": "그들은 나보다 강하니이다"
  },
  {
   "t": 131.5,
   "text": "내 영혼을 옥에서 이끌어 내사"
  },
  {
   "t": 138.5,
   "text": "주의 이름에 감사하게 하소서"
  },
  {
   "t": 145.5,
   "text": "주께서 내게 갚아 주시리니"
  },
  {
   "t": 152.5,
   "text": "의인들이 나를 둘러싸리이다"
  },
  {
   "t": 163.5,
   "text": "주는 나의 피난처 나의 몫이시라"
  }
 ]
}
