 "by": "auto",
 "lines": [
  {
   "t": 15,
   "text": "하나님의 아들들아 여호와께 돌리라"
  },
  {
   "t": 21,
   "text": "영광과 능력을 주께 돌리라"
  },
  {
   "t": 27,
   "text": "그 이름에 걸맞은 영광 드리고"
  },
  {
   "t": 33,
   "text": "거룩한 옷을 입고 경배하라"
  },
  {
   "t": 42,
   "text": "여호와의 소리가 물 위에 있네"
  },
  {
   "t": 48,
   "text": "영광의 하나님이 우레를 울리시네"
  },
  {
   "t": 54,
   "text": "여호와의 소리는 힘이 있고"
  },
  {
   "t": 59,
   "text": "여호와의 소리는 위엄차네"
  },
  {
   "t": 83,
   "text": "여호와의 소리가 백향목을 꺾네"
  },
  {
   "t": 89,
   "text": "레바논의 백향목을 부수시네"
  },
  {
   "t": 94,
   "text": "레바논을 송아지같이"
  },
  {
   "t": 99,
   "text": "시룐을 들소 새끼같이 뛰게 하시네"
  },
  {
   "t": 109,
   "text": "여호와의 소리가 불꽃을 가르고"
  },
  {
   "t": 113,
   "text": "광야를 흔드시네"
  },
  {
   "t": 116,
   "text": "가데스 광야를 흔드시네"
  },
  {
   "t": 121,
   "text": "그 성전에서 모두가 영광이라 외치네"
  },
  {
   "t": 127,
   "text": "여호와께서 홍수 위에 앉으셨네"
  },
  {
   "t": 133,
   "text": "영원히 왕으로 앉으셨네"
  },
  {
   "t": 142,
   "text": "여호와의 소리가 물 위에 있네"
  },
  {
   "t": 148,
   "text": "영광의 하나님이 우레를 울리시네"
  },
  {
   "t": 154,
   "text": "여호와께서 그 백성에게 힘을 주시리"
  },
  {
   "t": 160,
   "text": "그 백성에게 평강의 복을 주시리"
  },
  {
   "t": 171,
   "text": "평강의 복을 주시리"
  }
 ]
}
