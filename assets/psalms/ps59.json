 "by": "auto",
 "lines": [
  {
   "t": 16.5,
   "text": "나의 하나님 원수에게서 나를 건지소서"
  },
  {
   "t": 21.5,
   "text": "일어나 치는 자들 위로 나를 높이소서"
  },
  {
   "t": 27.5,
   "text": "악을 꾀하는 자들에게서 나를 빼내시고"
  },
  {
   "t": 32.5,
   "text": "피 흘리기 즐기는 자에게서 구하소서"
  },
  {
   "t": 40,
   "text": "보소서 그들이 엎드려 기다리며"
  },
  {
   "t": 45,
   "text": "내 목숨을 노리고 있나이다"
  },
  {
   "t": 51,
   "text": "내 허물도 내 죄도 없건마는"
  },
  {
   "t": 65,
   "text": "나의 힘이시여 내가 주를 바라리니"
  },
  {
   "t": 72,
   "text": "하나님은 나의 높은 망대시라"
  },
  {
   "t": 78,
   "text": "인자하신 나의 하나님이"
  },
  {
   "t": 84,
   "text": "나를 맞으러 오시리라"
  },
  {
   "t": 95,
   "text": "저녁이면 그들이 돌아와서"
  },
  {
   "t": 100,
   "text": "개처럼 울며 성을 두루 다니네"
  },
  {
   "t": 106,
   "text": "입술에는 칼을 물고서"
  },
  {
   "t": 111,
   "text": "누가 듣겠느냐 말하네"
  },
  {
   "t": 117,
   "text": "그러나 여호와여 주는 그들을 비웃으시리"
  },
  {
   "t": 123,
   "text": "뭇 나라를 우습게 여기시리라"
  },
  {
   "t": 128,
   "text": "나는 주의 힘을 노래하리"
  },
  {
   "t": 134,
   "text": "아침에 주의 인자하심을 높이 부르리"
  },
  {
   "t": 141,
   "text": "나의 환난 날에 주는"
  },
  {
   "t": 146,
   "text": "나의 요새 나의 피난처시라"
  },
  {
   "t": 153,
   "text": "나의 힘이시여 주를 찬송하리"
  }
 ],
 "seek": true
}
