 "by": "auto",
 "lines": [
  {
   "t": 18.5,
   "text": "주여 주는 대대로"
  },
  {
   "t": 26.5,
   "text": "우리의 거처가 되셨네"
  },
  {
   "t": 38.5,
   "text": "산이 생기기 전 땅이 지어지기 전"
  },
  {
   "t": 46.5,
   "text": "영원부터 영원까지 주는 하나님"
  },
  {
   "t": 56.5,
   "text": "사람을 티끌로 돌아가게 하시며"
  },
  {
   "t": 64.5,
   "text": "인생들아 돌아가라 하시네"
  },
  {
   "t": 73.5,
   "text": "천 년도 주의 눈앞에서는"
  },
  {
   "t": 81.5,
   "text": "지나간 어제 같고 밤의 한순간 같네"
  },
  {
   "t": 94.5,
   "text": "아침에 돋는 풀과 같아서"
  },
  {
   "t": 105.5,
   "text": "아침엔 피었다가 저녁엔 시드네"
  },
  {
   "t": 116.5,
   "text": "우리 날이 칠십이요 강건하면 팔십"
  },
  {
   "t": 124.5,
   "text": "날아가듯 빨리 지나가네"
  },
  {
   "t": 132.5,
   "text": "우리에게 우리 날을 세는 법을"
  },
  {
   "t": 140.5,
   "text": "가르쳐 주소서"
  },
  {
   "t": 144.5,
   "text": "지혜로운 마음을"
  },
  {
   "t": 148.5,
   "text": "얻게 하소서"
  },
  {
   "t": 154.5,
   "text": "여호와여 돌아오소서 언제까지니이까"
  },
  {
   "t": 164.5,
   "text": "아침에 주의 인자로 우리를 채우사"
  },
  {
   "t": 172.5,
   "text": "평생 즐겁고 기쁘게 하소서"
  },
  {
   "t": 182.5,
   "text": "주의 은총을 우리에게 내리사"
  },
  {
   "t": 192.5,
   "text": "우리 손이 하는 일을 견고하게 하소서"
  },
  {
   "t": 202.5,
   "text": "우리 날을 세는 법을 가르치사"
  },
  {
   "t": 210.5,
   "text": "지혜로운 마음을 얻게 하소서"
  },
  {
   "t": 219.5,
   "text": "우리 손의 일을 견고하게 하소서"
  }
 ],
 "seek": true
}
