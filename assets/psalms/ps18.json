 "lines": [
  {
   "t": 19.5,
   "text": "나의 힘이신 여호와여"
  },
  {
   "t": 25.5,
   "text": "내가 주를 사랑하나이다"
  },
  {
   "t": 32.5,
   "text": "사망의 줄이 나를 얽고"
  },
  {
   "t": 40,
   "text": "멸망의 물결이 나를 덮을 때"
  },
  {
   "t": 51.5,
   "text": "내가 환난 중에 여호와께 부르짖으니"
  },
  {
   "t": 58.5,
   "text": "그 성전에서 내 소리를 들으셨네"
  },
  {
   "t": 106.5,
   "text": "여호와는 나의 반석 나의 요새"
  },
  {
   "t": 110.5,
   "text": "나를 건지시는 나의 하나님"
  },
  {
   "t": 114,
   "text": "내가 피할 바위 나의 방패"
  },
  {
   "t": 117.5,
   "text": "나의 구원의 뿔 나의 산성이시라"
  },
  {
   "t": 131.5,
   "text": "땅이 흔들리고 산의 터가 떨렸네"
  },
  {
   "t": 139,
   "text": "하늘을 드리우고 내려오셨네"
  },
  {
   "t": 146.5,
   "text": "높은 데서 손을 펴 나를 붙드시고"
  },
  {
   "t": 154,
   "text": "많은 물에서 나를 건져 내셨네"
  },
  {
   "t": 201.5,
   "text": "주께서 나의 등불을 켜시니"
  },
  {
   "t": 202.1,
   "text": "여호와 내 하나님이 내 어둠을 밝히시네"
  },
  {
   "t": 202.6,
   "text": "내가 주를 힘입어 적진으로 달리고"
  },
  {
   "t": 203.2,
   "text": "나의 하나님을 힘입어 담을 뛰어넘네"
  },
  {
   "t": 203.8,
   "text": "내 발을 사슴 발 같게 하시고"
  },
  {
   "t": 204.3,
   "text": "나를 넓은 곳으로 이끄셨네"
  },
  {
   "t": 204.9,
   "text": "여호와는 나의 반석 나의 요새"
  },
  {
   "t": 205.5,
   "text": "나를 건지시는 나의 하나님"
  },
  {
   "t": 206,
   "text": "여호와는 살아 계시니"
  },
  {
   "t": 206.6,
   "text": "나의 반석을 찬송하리라"
  },
  {
   "t": 207.2,
   "text": "나의 반석을 찬송하리라"
