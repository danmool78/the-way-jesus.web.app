 "lines": [
  {
   "t": 18.5,
   "text": "내 하나님 내 하나님"
  },
  {
   "t": 24.5,
   "text": "어찌하여 나를 버리셨나이까"
  },
  {
   "t": 33,
   "text": "낮에도 부르짖으나 응답이 없고"
  },
  {
   "t": 40,
   "text": "밤에도 나는 잠잠할 수 없네"
  },
  {
   "t": 45,
   "text": "그러나 이스라엘의 찬송 가운데"
  },
  {
   "t": 53,
   "text": "거룩하게 계시는 주여"
  },
  {
   "t": 58.5,
   "text": "우리 조상들이 주를 믿었을 때"
  },
  {
   "t": 66,
   "text": "주께서 그들을 건지셨나이다"
  },
  {
   "t": 74,
   "text": "내 하나님 내 하나님"
  },
  {
   "t": 80,
   "text": "어찌하여 나를 버리셨나이까"
  },
  {
   "t": 88.5,
   "text": "여호와여 멀리 계시지 마소서"
  },
  {
   "t": 94.5,
   "text": "나의 힘이여 속히 나를 도우소서"
  },
  {
   "t": 101.5,
   "text": "나는 벌레요 사람이 아니라"
  },
  {
   "t": 108.5,
   "text": "보는 자마다 입술을 비쭉이며 비웃네"
  },
  {
   "t": 116.5,
   "text": "그가 여호와께 맡겼으니 건지시라 하네"
  },
  {
   "t": 123.5,
   "text": "내 몸은 물같이 쏟아지고"
  },
  {
   "t": 127,
   "text": "내 손과 발을 찔렀나이다"
  },
  {
   "t": 131,
   "text": "내 겉옷을 나누고 속옷을 제비 뽑네"
  },
  {
   "t": 141,
   "text": "주께서 내게 응답하셨나이다"
  },
  {
   "t": 148,
   "text": "내가 주의 이름을 형제들에게 전하고"
  },
  {
   "t": 155,
   "text": "회중 가운데서 주를 찬송하리라"
  },
  {
   "t": 163.5,
   "text": "땅의 모든 끝이 여호와께 돌아오고"
  },
  {
   "t": 171,
   "text": "모든 민족이 주 앞에 엎드리리"
  },
  {
   "t": 178.5,
   "text": "아직 나지 않은 백성에게 전하리라"
  },
  {
   "t": 186,
   "text": "주께서 이 일을 이루셨다고"
  },
  {
   "t": 193.5,
   "text": "주께서 이루셨네"
  }
