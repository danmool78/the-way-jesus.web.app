{
 "src": "https://pub-7d2b46014d5b4769a48e210890df23c4.r2.dev/psalms/ps68-ed5d82cf1d.mp3",
 "audio": "ed5d82cf1dff7bb5477ebe2005dfc0867884fe4ba3a54af3980c1e6ccc002f6c",
 "by": "auto",
 "lines": [
  {
   "t": 18.5,
   "text": "하나님이 일어나시니"
  },
  {
   "t": 22.5,
   "text": "원수들은 흩어지고"
  },
  {
   "t": 28.5,
   "text": "연기가 바람에 날리듯"
  },
  {
   "t": 33.5,
   "text": "미워하는 자 주 앞에서 도망하네"
  },
  {
   "t": 39.5,
   "text": "구름 타고 광야를 지나시는 분께"
  },
  {
   "t": 43.5,
   "text": "큰길을 닦고 노래하여라"
  },
  {
   "t": 48.5,
   "text": "그의 이름은 여호와"
  },
  {
   "t": 52.5,
   "text": "그 앞에서 기뻐 뛰놀아라"
  },
  {
   "t": 59.5,
   "text": "고아의 아버지 과부의 재판장"
  },
  {
   "t": 64.5,
   "text": "거룩한 처소에 계신 하나님"
  },
  {
   "t": 69.5,
   "text": "외로운 자에게 집을 주시고"
  },
  {
   "t": 74.5,
   "text": "갇힌 자를 이끌어 내시네"
  },
  {
   "t": 79.5,
   "text": "주께서 백성 앞에 나가시어"
  },
  {
   "t": 84.5,
   "text": "광야를 행진하실 때"
  },
  {
   "t": 89.5,
   "text": "땅이 떨고 하늘이 비를 쏟았네"
  },
  {
   "t": 94.5,
   "text": "시내산도 주 앞에서 떨었네"
  },
  {
   "t": 102.5,
   "text": "날마다 우리 짐을 지시는 주"
  },
  {
   "t": 107.5,
   "text": "우리 구원의 하나님을 찬송하라"
  },
  {
   "t": 112.5,
   "text": "노래하는 자는 앞에 서고"
  },
  {
   "t": 115.5,
   "text": "악기 타는 자는 뒤를 따르네"
  },
  {
   "t": 117.5,
   "text": "소고 치는 처녀들 사이로"
  },
  {
   "t": 122.5,
   "text": "성소로 들어가시는 나의 왕"
  },
  {
   "t": 143.5,
   "text": "땅의 나라들아 하나님께 노래하라"
  },
  {
   "t": 148.5,
   "text": "구름 타고 오시는 주를 찬송하라"
  },
  {
   "t": 153.5,
   "text": "그의 이름은 여호와"
  },
  {
   "t": 158.5,
   "text": "그 앞에서 기뻐 뛰놀아라"
  },
  {
   "t": 163.5,
   "text": "하나님을 찬송하라"
  }
 ]
}
