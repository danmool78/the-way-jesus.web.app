{
 "src": "https://pub-7d2b46014d5b4769a48e210890df23c4.r2.dev/psalms/ps68-f348b2bb9d.mp3",
 "audio": "f348b2bb9df88d130bbbcde408473df06c31af79eececb4a780549320c0589bc",
 "by": "auto",
 "lines": [
  {
   "t": 16.5,
   "text": "하나님이 일어나시니"
  },
  {
   "t": 20.5,
   "text": "원수들은 흩어지고"
  },
  {
   "t": 25,
   "text": "연기가 바람에 날리듯"
  },
  {
   "t": 29.5,
   "text": "미워하는 자 주 앞에서 도망하네"
  },
  {
   "t": 34,
   "text": "구름 타고 광야를 지나시는 분께"
  },
  {
   "t": 38.5,
   "text": "큰길을 닦고 노래하여라"
  },
  {
   "t": 43.5,
   "text": "그의 이름은 여호와"
  },
  {
   "t": 48.5,
   "text": "그 앞에서 기뻐 뛰놀아라"
  },
  {
   "t": 56.5,
   "text": "고아의 아버지 과부의 재판장"
  },
  {
   "t": 61.5,
   "text": "거룩한 처소에 계신 하나님"
  },
  {
   "t": 66.5,
   "text": "외로운 자에게 집을 주시고"
  },
  {
   "t": 71.5,
   "text": "갇힌 자를 이끌어 내시네"
  },
  {
   "t": 76.5,
   "text": "주께서 백성 앞에 나가시어"
  },
  {
   "t": 81.5,
   "text": "광야를 행진하실 때"
  },
  {
   "t": 86.5,
   "text": "땅이 떨고 하늘이 비를 쏟았네"
  },
  {
   "t": 91.5,
   "text": "시내산도 주 앞에서 떨었네"
  },
  {
   "t": 99.5,
   "text": "날마다 우리 짐을 지시는 주"
  },
  {
   "t": 104.5,
   "text": "우리 구원의 하나님을 찬송하라"
  },
  {
   "t": 109.5,
   "text": "노래하는 자는 앞에 서고"
  },
  {
   "t": 113.5,
   "text": "악기 타는 자는 뒤를 따르네"
  },
  {
   "t": 118.5,
   "text": "소고 치는 처녀들 사이로"
  },
  {
   "t": 123.5,
   "text": "성소로 들어가시는 나의 왕"
  },
  {
   "t": 137.5,
   "text": "땅의 나라들아 하나님께 노래하라"
  },
  {
   "t": 142.5,
   "text": "구름 타고 오시는 주를 찬송하라"
  },
  {
   "t": 147.5,
   "text": "그의 이름은 여호와"
  },
  {
   "t": 152.5,
   "text": "그 앞에서 기뻐 뛰놀아라"
  },
  {
   "t": 157.5,
   "text": "하나님을 찬송하라"
  }
 ],
 "seek": true
}
